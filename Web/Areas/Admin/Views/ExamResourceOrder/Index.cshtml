@model IEnumerable<ExamResourceOrderViewModel>

@{
    ViewData["PageTitle"] = $"لیست سفارشات {ViewBag.ApplicantFullName}";
}

<div class="accordion" id="custom-accordion-one" style="margin-top:-14px;">
    <div class="card mb-0">
        <div class="card-header" id="headingOne" style="max-height:40px;padding-top:0px;border-radius:4px;">
            <h5 class="m-0">
                <a class="custom-accordion-title d-block pt-2 pb-2 collapsed"
                   data-bs-toggle="collapse" href="#collapseOne"
                   aria-expanded="true" aria-controls="collapseOne">
                    <i class="uil uil-filter" style="color:orangered;"></i>
                    <b style="font-size:16px;margin-right:5px;">فیلتر اطلاعات</b>
                    <i class="mdi mdi-chevron-up accordion-arrow" style="float:left;color:orangered;"></i>
                </a>
            </h5>
        </div>

        <div id="collapseOne" class="collapse"
             aria-labelledby="headingOne" data-bs-parent="#accordionExample">
            <div class="card-body">
                <div class="row" style="margin-top:22px;">
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "نام منبع", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                @Html.Editor("FilterResourceName")
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "وضعیت", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                @(Html.Kendo().DropDownList()
                                                                .Name("FilterStatus")
                                                                .DataTextField("Text")
                                                                .DataValueField("Value")
                                                                .OptionLabel("همه")
                                                                .HtmlAttributes(new { style = "width: 100%" })
                                                                .BindTo(new List<SelectListItem>() {
                                                                new SelectListItem() {
                                                                Text = "درحال بررسی",
                                                                Value = "1"
                                                                },
                                                                new SelectListItem() {
                                                                Text = "پرداخت شده",
                                                                Value = "2"
                                                                },
                                                                new SelectListItem() {
                                                                Text = "ارسال شده",
                                                                Value = "3"
                                                                },
                                                                new SelectListItem() {
                                                                Text = "تحویل داده شده",
                                                                Value = "4"
                                                                },
                                                                new SelectListItem() {
                                                                Text = "دانلود شده",
                                                                Value = "5"
                                                                }
                                                                }))
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row" style="margin-top:22px;">
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "قیمت از", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                @Html.Editor("FilterTotalPriceFrom")
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "قیمت تا", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                @Html.Editor("FilterTotalPriceTo")
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row" style="margin-top:22px;">
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "تاریخ ثبت سفارش از", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                <div>
                                    <div style="display:inline-block;width:100%;">
                                        <input type="text" class="form-control" id="FilterOrderDateFrom" name="FilterOrderDateFrom"
                                               data-ha-datetimepicker="#FilterOrderDateFrom" data-ha-dp-issolar="true"
                                               data-ha-dp-disabletime="true" data-ha-dp-resultinsolar="true"
                                               data-ha-dp-resultformat="{year}/{month}/{day}" value="" style="display:inline;" />
                                    </div>
                                    <div style="display:inline-block;margin-right:-30px;">
                                        <i class="fa fa-calendar" style="color: #034ea2;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "تاریخ ثبت سفارش تا", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                <div>
                                    <div style="display:inline-block;width:100%;">
                                        <input type="text" class="form-control" id="FilterOrderDateTo" name="FilterOrderDateTo"
                                               data-ha-datetimepicker="#FilterOrderDateTo" data-ha-dp-issolar="true"
                                               data-ha-dp-disabletime="true" data-ha-dp-resultinsolar="true"
                                               data-ha-dp-resultformat="{year}/{month}/{day}" value="" style="display:inline;" />
                                    </div>
                                    <div style="display:inline-block;margin-right:-30px;">
                                        <i class="fa fa-calendar" style="color: #034ea2;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="row" style="margin-top:22px;">
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "تاریخ ارسال سفارش از", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                <div>
                                    <div style="display:inline-block;width:100%;">
                                        <input type="text" class="form-control" id="FilterDeliveryDateFrom" name="FilterDeliveryDateFrom"
                                               data-ha-datetimepicker="#FilterDeliveryDateFrom" data-ha-dp-issolar="true"
                                               data-ha-dp-disabletime="true" data-ha-dp-resultinsolar="true"
                                               data-ha-dp-resultformat="{year}/{month}/{day}" value="" style="display:inline;" />
                                    </div>
                                    <div style="display:inline-block;margin-right:-30px;">
                                        <i class="fa fa-calendar" style="color: #034ea2;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "تاریخ ارسال سفارش تا", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                <div>
                                    <div style="display:inline-block;width:100%;">
                                        <input type="text" class="form-control" id="FilterDeliveryDateTo" name="FilterDeliveryDateTo"
                                               data-ha-datetimepicker="#FilterDeliveryDateTo" data-ha-dp-issolar="true"
                                               data-ha-dp-disabletime="true" data-ha-dp-resultinsolar="true"
                                               data-ha-dp-resultformat="{year}/{month}/{day}" value="" style="display:inline;" />
                                    </div>
                                    <div style="display:inline-block;margin-right:-30px;">
                                        <i class="fa fa-calendar" style="color: #034ea2;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <hr style="margin-top:22px;" />
                <a class="btn btn-info" style="float:left;margin-bottom:10px;" onclick="filterData()">فیلتر اطلاعات</a>

            </div>
        </div>
    </div>

    <div class="k-rtl" style="margin-top:20px;">
        <div style="height:100%;">
            @(
                        Html.Kendo().Grid<ExamResourceOrderViewModel>().Name("Grid").Columns(columns =>
                        {
                            columns.Bound(c => c.ResourceName).Width(250);
                            columns.Bound(c => c.ShamsiOrderDate).Width(250);
                            columns.Bound(c => c.ShamsiDeliveryDate).Width(250);
                            columns.Bound(c => c.StatusStr).Width(250);
                            columns.Command(command =>
                            {
                                command.Custom("ویرایش").Click("editRow").HtmlAttributes(new { @class = "command-btn-yellow" });

                                command.Custom("حذف").Click("deleteRow").HtmlAttributes(new { @class = "command-btn-red" });

                            }).Width(400);
                        })
                        .HtmlAttributes(new { style = "height: 550px;border-radius:0.25rem;" })
                        .Filterable(ftb => ftb.Mode(GridFilterMode.Menu))
                        .Scrollable(scrollable => scrollable.Virtual(true))
                        .Sortable()
                        .Pageable(pageable => pageable
                        .Refresh(true)
                        .PageSizes(true)
                        .ButtonCount(5))
                        .DataSource(dataSource => dataSource
                        .Ajax()
                        .Events(events => events.Error("error_handler"))
                        .Model(model =>
                        {
                            model.Id(x => x.ExamResourceId);
                        })
                        .Read(read => read.Action("Grid_Data_Read", "ExamResourceOrder", new { Area = "Admin" })
                        .Data("getFilterDataParams"))
                        .PageSize(20)
                        )
                        )
        </div>
    </div>
    <div class="row" style="margin-top:20px;">
        <div class="col-xs-6 col-sm-6 col-md-6">
            <a href="@Url.Action("Create", "ExamResourceOrder")" class="btn btn-success form-command-btn" style="display:inline-block;float:right;">
                <span><i class="fa fa-plus"></i><span>&nbsp;</span>ثبت جدید</span>
            </a>
        </div>
        <div class="col-xs-6 col-sm-6 col-md-6 text-left">
             <a href="@Url.Action("Index", "Applicant")" class="btn btn-info form-command-btn" style="float:left;">
            <span class="btn-label"><i class="fa fa-reply"></i><span>&nbsp;</span>بازگشت</span>
            </a> 
        </div>
    </div>
</div>

<script type="text/javascript">

    function editRow(e) {
        e.preventDefault();
        var dataItem = this.dataItem(jQuery(e.currentTarget).closest("tr"));
        window.location.href = "/Admin/ExamResourceOrder/Edit/" + dataItem.ExamResourceOrderId;
    }

    var getFilterDataParams = function (e) {
        var result = {
            filterApplicantId: @ViewBag.ApplicantId,
            filterExamResourceId: null,
            filterStatus: $('#FilterStatus').val(),
            filterTotalPriceFrom: $('#FilterTotalPriceFrom').val(),
            filterTotalPriceTo: $('#FilterTotalPriceTo').val(),
            filterOrderDateFrom: $('#FilterOrderDateFrom').val(),
            filterOrderDateTo: $('#FilterOrderDateTo').val(),
            filterDeliveryDateFrom: $('#FilterDeliveryDateFrom').val(),
            filterDeliveryDateTo: $('#FilterDeliveryDateTo').val(),
        }
        return result;
    };

    function filterData() {
        $("#Grid").data("kendoGrid").dataSource.read();
    }

    function deleteRow(e) {
            e.preventDefault();
            var dataItem = this.dataItem(jQuery(e.currentTarget).closest("tr"));

            showConfirmModalMessage(
                "danger",
                "عملیات حذف",
                "آیا از حذف اطمینان دارید؟",
                "انصراف",
                "حذف",
                "danger",
                "Confirm",
                dataItem.ExamResourceOrderId,
                "Cancel",
                null
            );
    }

    function Confirm(examResourceOrderId) {
        $.ajax({
            url: '/Admin/ExamResourceOrder/Delete',
            type: "GET",
            data: {
                id: examResourceOrderId
            }
        }).done(function (dresult) {
            if (dresult == true) {
                var reqGrid = $("#Grid").data("kendoGrid");
                reqGrid.dataSource.read();
                showSimpleModalMessage('success', 'عملیات انجام شد', 'اطلاعات موردنظر حذف شد', '');
            }
            else {
                showSimpleModalMessage('danger', 'خطا', 'امکان حذف این اطلاعات وجود ندارد', '');
            }
        }).fail(function (xhr) {
            showSimpleModalMessage('danger', 'خطا', 'در ارسال درخواست خطا رخ داد: ' + (xhr.responseText || xhr.statusText), '');
        });
    }

    function Cancel(x) {

    }

</script>