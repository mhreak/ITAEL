@model Web.Model.ExamQuestionViewModel
@{
    ViewData["PageTitle"] = "ویرایش سوال آزمون";
}

<div style="margin-top:-14px;">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { name = "my-form", id = "my-form" }))
    {
        @Html.HiddenFor(m => m.ExamQuestionId)
        @Html.HiddenFor(m => m.ExamId)
        @Html.HiddenFor(m => m.ExamTitle)
        @Html.HiddenFor(m => m.TypeStr)

        <div class="container-card padding30" style="padding-top:45px;">
            <div class="form-horizontal">

                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(m => m.Text, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })

                    <div class="col-md-3 col-sm-4">
                        @Html.EditorFor(m => m.Text)
                        @Html.ValidationMessageFor(m => m.Text, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-7 col-sm-5">
                        <span style="color:red;font-size:20px;">*</span>
                    </div>
                </div>

                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(m => m.QuestionOrder, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })

                    <div class="col-md-3 col-sm-4">
                        @Html.EditorFor(m => m.QuestionOrder, new { htmlAttributes = new { @type = "number", @min = "0", @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.QuestionOrder, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-7 col-sm-5">
                        <span style="color:red;font-size:20px;">*</span>
                    </div>
                </div>

                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(m => m.Grade, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })

                    <div class="col-md-3 col-sm-4">
                        @Html.EditorFor(m => m.Grade, new { htmlAttributes = new { @type = "number", @min = "0", @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.Grade, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-7 col-sm-5">
                        <span style="color:red;font-size:20px;">*</span>
                    </div>
                </div>

                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(m => m.Type, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })

                    <div class="col-md-3 col-sm-4">
                        @(Html.Kendo().DropDownList()
                              .Name("Type")
                              .DataTextField("Text")
                              .DataValueField("Value")
                              .OptionLabel("همه")
                              .HtmlAttributes(new { style = "width: 100%" })
                              .Value(Model.Type.ToString())
                              .BindTo(new List<SelectListItem>() {
                                                                     new SelectListItem() { Text = "چندگزینه ای", Value = "1" },
                                                                     new SelectListItem() { Text = "تشریحی", Value = "2" }
                                                                 })
                              .Events(e => e.Change("onTypeChange"))
                        )
                        @Html.ValidationMessageFor(m => m.Type, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-7 col-sm-5">
                        <span style="color:red;font-size:20px;">*</span>
                    </div>
                </div>
                
                @if (Model.Type == 2)
                {
                    <div id="answer-text-wrapper" style="display:none;">
                        <div class="row form-group" style="margin-top:30px;">
                            @Html.LabelFor(model => model.AnswerText, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                            <div class="col-md-3 col-sm-4">
                                @Html.EditorFor(model => model.AnswerText)
                                @Html.ValidationMessageFor(model => model.AnswerText, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-7 col-sm-5">
                                <span style="color:red;font-size:20px;">*</span>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>

        <hr style="margin-top:45px;color:orangered;" />

        <div class="row" style="margin-top:12px;">
            <div class="col-md-6 col-sm-12">
                <input type="submit" class="btn btn-success form-command-btn" value="ذخیره" style="float:right;" />
            </div>
            <div class="col-md-6 col-sm-12">
                <a href="@Url.Action("Index", "ExamQuestion", new { Area = "Admin", examId = Model.ExamId })"
                   class="btn btn-danger form-command-btn" style="float: left;">بازگشت</a>

            </div>
        </div>
        }
</div>

<script>
    function onTypeChange(e) {
        const value = this.value();

        if (value === "2") {
            // تشریحی → AnswerText را نشان بده
            $("#answer-text-wrapper").show();
        } else {
            // چندگزینه ای → AnswerText را مخفی کن
            $("#answer-text-wrapper").hide();
        }
    }
</script>