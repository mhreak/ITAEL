@model Web.Model.ExamQuestionViewModel

@{
    ViewData["PageTitle"] = "ثبت سوال جدید";
}

<style>
    .k-multiselect {
        border: 1px solid #c8c9ce !important;
        border-radius: 8px !important;
        background: white;
    }

    .k-chip-label {
        font-family: IranSans;
    }


    .k-selection-multiple input {
        font-size: 14px;
    }
</style>

<div style="margin-top:-14px;">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { name = "my-form", id = "my-form" }))
    {

        <input type="hidden" name="ExamId" id="ExamId" value="@ViewBag.ExamId"/>

        <div class="container-card padding30" style="padding-top:45px;">
            <div class="form-horizontal">
                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.Text, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @Html.EditorFor(model => model.Text)
                        @Html.ValidationMessageFor(model => model.Text, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-7 col-sm-5">
                        <span style="color:red;font-size:20px;">*</span>
                    </div>
                </div>

                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.QuestionOrder, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @Html.EditorFor(model => model.QuestionOrder, new { htmlAttributes = new { @type = "number", @min = "0", @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.QuestionOrder, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-7 col-sm-5">
                        <span style="color:red;font-size:20px;">*</span>
                    </div>
                </div>

                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.Type, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @(Html.Kendo().DropDownList()
                                            .Name("Type")
                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .OptionLabel("همه")
                                            .HtmlAttributes(new { style = "width: 100%" })
                                            .BindTo(new List<SelectListItem>() {
                                        new SelectListItem() {
                                        Text = "چندگزینه ای",
                                        Value = "1"
                                        },
                                        new SelectListItem() {
                                        Text = "تشریحی",
                                        Value = "2"
                                        }
                                            }))
                    @Html.ValidationMessageFor(model => model.Type, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-7 col-sm-5">
                    <span style="color:red;font-size:20px;">*</span>
                </div>
            </div>

                <div class="col-md-7 col-sm-5">
                </div>
            </div>
            <hr style="margin-top:45px;color:orangered;" />
            <div class="row" style="margin-top:12px;">
                <div class="col-md-6 col-sm-12">
                    <input type="submit" class="btn btn-success form-command-btn" value="ذخیره" style="float:right;" />
                </div>
                <div class="col-md-6 col-sm-12">
                    <a href=@Url.Action("Index", "ExamQuestion", new { Area = "Admin", examId = ViewBag.ExamId }) class="btn btn-danger form-command-btn" style="float: left;">بازگشت</a>
                </div>
            </div>
        </div>
        }
</div>