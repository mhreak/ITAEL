    <style>
        * {
            font-family: IRANSans, Arial, sans-serif;
        }

        #top-animated-overlay {
            height: 380px;
            background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
            background-size: 400% 400%;
            animation: gradient 60s ease infinite;
        }

        @@keyframes gradient {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }
    </style>

    <style>
        #footerSlideContainer {
            position: fixed;
            bottom: 0;
            width: 100%;
            z-index: 1000;
        }

        #footerSlideButton {
            background: url(sliderButton.png) top left no-repeat #ccc;
            width: 50px;
            height: 50px;
            border: none;
            cursor: pointer;
        }

        #footerSlideBody {
            width: 100%;
            height: 0px;
            background: #fff;
            color: #CCCCCC;
            font-size: 0.8em;
            border: none;
            box-shadow: 0 -120px 250px -80px rgba(0, 0, 0, 0.15);
            font-family: DejaVuSansBook, Sans-Serif;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        #footerSlideText {
            padding: 15px 10px 25px 25px;
        }

        #footer-drawer-title {
            text-align: right;
            font-weight: bold;
            color: #193A60;
            font-family: IranSans;
            font-size: 20px;
        }

        #footer-drawer-close-icon {
            width: 32px;
            float: left;
            margin-top: 10px;
            cursor: pointer;
            transition: transform 0.6s ease-in-out;
        }

            #footer-drawer-close-icon:hover {
                transform: rotate(360deg);
            }
    </style>

    <style>
        /* برای مرورگرهای WebKit: Chrome, Edge, Safari */
        *::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        *::-webkit-scrollbar-track {
            background: #f5f5f5;
            border-radius: 10px;
        }

        *::-webkit-scrollbar-thumb {
            background-color: #c1c1c1;
            border-radius: 10px;
            border: 2px solid #f5f5f5; /* فضای بین thumb و track */
        }

            *::-webkit-scrollbar-thumb:hover {
                background-color: #999;
            }

        /* Firefox scrollbar */
        * {
            scrollbar-width: thin; /* یا "auto" یا "none" */
            scrollbar-color: #c1c1c1 #f5f5f5; /* thumb | track */
        }
    </style>

    <style>
        @@keyframes blink {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0;
            }
        }

        .blink {
            animation: blink 0.3s ease-in-out 2; /* 2 بار تکرار */
        }

        .copy-to-clipboard {
            cursor: pointer;
        }
    </style>
</head>

