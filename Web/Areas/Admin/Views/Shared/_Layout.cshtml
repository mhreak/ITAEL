    <script>

        function showSimpleModalMessage(modalStyle, title, message, buttonText) {


            switch (modalStyle) {
                case 'info':
                    $('#msg-simple-modal-icon').addClass("dripicons-information");
                    $('#msg-simple-modal-icon').addClass("text-info");
                    $('#msg-simple-modal-button').addClass("btn-info");
                    break;
                case 'success':
                    $('#msg-simple-modal-content').addClass("modal-filled");
                    $('#msg-simple-modal-content').addClass("bg-success");
                    $('#msg-simple-modal-icon').addClass("dripicons-checkmark");
                    $('#msg-simple-modal-button').addClass("btn-light");
                    break;
                case "warning":
                    $('#msg-simple-modal-icon').addClass("dripicons-warning");
                    $('#msg-simple-modal-icon').addClass("text-warning");
                    $('#msg-simple-modal-button').addClass("btn-warning");
                    break;
                case 'danger':
                    $('#msg-simple-modal-content').addClass("modal-filled");
                    $('#msg-simple-modal-content').addClass("bg-danger");
                    $('#msg-simple-modal-icon').addClass("dripicons-wrong");
                    $('#msg-simple-modal-button').addClass("btn-light");
                    break;
            }

            if (message != '') {
                $('#msg-simple-modal-message').text(message);
            }

            if (buttonText != '') {
                $('#msg-simple-modal-button').text(buttonText);
            }

            $('#msg-simple-modal-title').text(title);
            $('#msg-simple-modal').modal('toggle');
        }

        function showModalMessage(modalStyle, title, message, cancelButtonText, showButton,
            buttonText, buttonStyle) {

            switch (modalStyle) {
                case 'info':
                    $('#msg-modal-header').addClass("bg-info");
                    break;
                case 'success':
                    $('#msg-modal-header').addClass("bg-success");
                    break;
                case "warning":
                    $('#msg-modal-header').addClass("bg-warning");
                    break;
                case 'danger':
                    $('#msg-modal-header').addClass("bg-danger");
                    break;
            }

            if (title != '') {
                $('#msg-modal-title').text(title);
            }

            if (cancelButtonText != '') {
                $('#msg-modal-cancel-button').text(cancelButtonText);
            }

            if (showButton) {
                $('#msg-modal-button').show();
            }

            if (buttonText != '') {
                $('#msg-modal-button').text(buttonText);
            }

            switch (buttonStyle) {
                case 'light':
                    $('#msg-modal-button').addClass("btn-light");
                    break;
                case 'info':
                    $('#msg-modal-button').addClass("btn-info");
                    break;
                case 'success':
                    $('#msg-modal-button').addClass("btn-success");
                    break;
                case "warning":
                    $('#msg-modal-button').addClass("btn-warning");
                    break;
                case 'danger':
                    $('#msg-modal-button').addClass("btn-danger");
                    break;
            }

            $('#msg-modal-message').html(message);

            $('#msg-modal').modal('toggle');
        }

        function showConfirmModalMessage(modalStyle, title, message, cancelButtonText,
            confirmButtonText, confirmButtonStyle, cofirmFunctionName, confirmFunctionArguments,
            cancelFunctionName, cancelFunctionArguments) {

            switch (modalStyle) {
                case 'info':
                    $('#confirm-modal-header').addClass("bg-info");
                    break;
                case 'success':
                    $('#confirm-modal-header').addClass("bg-success");
                    break;
                case "warning":
                    $('#confirm-modal-header').addClass("bg-warning");
                    break;
                case 'danger':
                    $('#confirm-modal-header').addClass("bg-danger");
                    break;
            }

            if (title != '') {
                $('#confirm-modal-title').text(title);
            }

            if (cancelButtonText != '') {
                $('#confirm-modal-cancel-button').text(cancelButtonText);
            }

            if (confirmButtonText != '') {
                $('#confirm-modal-button').text(confirmButtonText);
            }

            switch (confirmButtonStyle) {
                case 'light':
                    $('#confirm-modal-button').addClass("btn-light");
                    break;
                case 'info':
                    $('#confirm-modal-button').addClass("btn-info");
                    break;
                case 'success':
                    $('#confirm-modal-button').addClass("btn-success");
                    break;
                case "warning":
                    $('#confirm-modal-button').addClass("btn-warning");
                    break;
                case 'danger':
                    $('#confirm-modal-button').addClass("btn-danger");
                    break;
            }

            $('#confirm-modal-message').html(message);

            $('#confirm-modal-button').off('click');

            if (cofirmFunctionName != '') {
                $('#confirm-modal-button').click(function () {
                    $('#confirm-modal').modal('toggle');
                    window[cofirmFunctionName](confirmFunctionArguments);
                });
            }
            else {
                $('#confirm-modal-button').click(function () {
                    $('#confirm-modal').modal('toggle');
                });
            }

            $('#confirm-modal-cancel-button').off('click');

            if (cancelFunctionName != '') {
                $('#confirm-modal-cancel-button').click(function () {
                    $('#confirm-modal').modal('toggle');
                    window[cancelFunctionName](cancelFunctionArguments);
                });
            }
            else {
                $('#confirm-modal-cancel-button').click(function () {
                    $('#confirm-modal').modal('toggle');
                });
            }

            $('#confirm-modal').modal('toggle');
        }

