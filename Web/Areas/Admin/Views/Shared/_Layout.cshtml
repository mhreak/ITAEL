    <script type="text/javascript">
        function error_handler(e) {
            if (e.errors) {
                var message = "Errors:\n";
                $.each(e.errors, function (key, value) {
                    if ('errors' in value) {
                        $.each(value.errors, function () {
                            message += this + "\n";
                        });
                    }
                });
                alert(message);
            }
        }

    </script>

    <script>
        $(function () {
            $('body').on('click', '.modal-link', function (e) {
                e.preventDefault();
                var href = $(this).attr('href');
                $.ajax({
                    type: "POST",
                    url: href,
                    data: {},
                    contentType: "application/json",
                    success: function (response) {
                        var modalBody = $("#modal-container").find(".modal-body");
                        modalBody.html(response);
                        $("#modal-container").modal('show');
                    },
                    failure: function (response) {
                        alert(response.responseText);
                    },
                    error: function (response) {
                        alert(response.responseText);
                    }
                });

            });
        });

        function closeModalDialog() {
            $("#modal-container").modal('hide');
        }

        function ExportGridExcelData() {

            //$("#Grid").kendoGrid({
            //    excelExport: function (e) {
            //        e.workbook.fileName = $('li.breadcrumb-item.active').text().replace(" ", "-") + ".xlsx";
            //        e.workbook.rtl = true;
            //    }
            //});

            var grid = $("#Grid").data("kendoGrid");

            grid.setOptions({
                excel: {
                    allPages: true
                }
            });

            grid.saveAsExcel();
        }
    </script>

    @{
        // try ViewData first (same-request). If not present, fallback to TempData (after redirect).
        bool showToast = false;
        string toastType = "";
        string toastTitle = "";
        string toastText = "";

        // ViewData (when controller set and no redirect)
        if (ViewData["ShowToast"] is bool vdShow && vdShow)
        {
            showToast = true;
            toastType = (ViewData["ToastType"] as string) ?? "";
            toastTitle = (ViewData["ToastTitle"] as string) ?? "";
            toastText = (ViewData["ToastText"] as string) ?? "";
        }
        else if (TempData["ShowToast"] != null && TempData["ShowToast"].ToString().ToLower() == "true")
        {
            // fallback to TempData (after redirect)
            showToast = true;
            toastType = (TempData["ToastType"] as string) ?? "";
            toastTitle = (TempData["ToastTitle"] as string) ?? "";
            toastText = (TempData["ToastText"] as string) ?? "";
        }
    }

    @if (showToast == true)
    {
        <script>
            // safely serialize server strings into JS (handles quotes / special chars)
            var _toastTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastTitle));
            var _toastText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastText));
            var _toastType = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastType));

            switch (_toastType) {
                case "info":
                    toastr.info(_toastText, _toastTitle, {
                        positionClass: "toast-bottom-left",
                        timeOut: 5000,
                        closeButton: true,
                        debug: false,
                        newestOnTop: true,
                        progressBar: true,
                        preventDuplicates: true,
                        onclick: null,
                        showDuration: "300",
                        hideDuration: "1000",
                        extendedTimeOut: "1000",
                        showEasing: "swing",
                        hideEasing: "linear",
                        showMethod: "fadeIn",
                        hideMethod: "fadeOut",
                        tapToDismiss: false
                    });
                    break;
                case "success":
                    toastr.success(_toastText, _toastTitle, {
                        positionClass: "toast-bottom-left",
                        timeOut: 5000,
                        closeButton: true,
                        debug: false,
                        newestOnTop: true,
                        progressBar: true,
                        preventDuplicates: true,
                        onclick: null,
                        showDuration: "300",
                        hideDuration: "1000",
                        extendedTimeOut: "1000",
                        showEasing: "swing",
                        hideEasing: "linear",
                        showMethod: "fadeIn",
                        hideMethod: "fadeOut",
                        tapToDismiss: false
                    });
                    break;
                case "warning":
                    toastr.warning(_toastText, _toastTitle, {
                        positionClass: "toast-bottom-left",
                        timeOut: 5000,
                        closeButton: true,
                        debug: false,
                        newestOnTop: true,
                        progressBar: true,
                        preventDuplicates: true,
                        onclick: null,
                        showDuration: "300",
                        hideDuration: "1000",
                        extendedTimeOut: "1000",
                        showEasing: "swing",
                        hideEasing: "linear",
                        showMethod: "fadeIn",
                        hideMethod: "fadeOut",
                        tapToDismiss: false
                    });
                    break;
                case "danger":
                    toastr.error(_toastText, _toastTitle, {
                        positionClass: "toast-bottom-left",
                        timeOut: 5000,
                        closeButton: true,
                        debug: false,
                        newestOnTop: true,
                        progressBar: true,
                        preventDuplicates: true,
                        onclick: null,
                        showDuration: "300",
                        hideDuration: "1000",
                        extendedTimeOut: "1000",
                        showEasing: "swing",
                        hideEasing: "linear",
                        showMethod: "fadeIn",
                        hideMethod: "fadeOut",
                        tapToDismiss: false
                    });
                    break;
                default:
                    // fallback
                    toastr.info(_toastText, _toastTitle);
                    break;
            }
        </script>
    }

    <script>

        function showSimpleModalMessage(modalStyle, title, message, buttonText) {


            switch (modalStyle) {
                case 'info':
                    $('#msg-simple-modal-icon').addClass("dripicons-information");
                    $('#msg-simple-modal-icon').addClass("text-info");
                    $('#msg-simple-modal-button').addClass("btn-info");
                    break;
                case 'success':
                    $('#msg-simple-modal-content').addClass("modal-filled");
                    $('#msg-simple-modal-content').addClass("bg-success");
                    $('#msg-simple-modal-icon').addClass("dripicons-checkmark");
                    $('#msg-simple-modal-button').addClass("btn-light");
                    break;
                case "warning":
                    $('#msg-simple-modal-icon').addClass("dripicons-warning");
                    $('#msg-simple-modal-icon').addClass("text-warning");
                    $('#msg-simple-modal-button').addClass("btn-warning");
                    break;
                case 'danger':
                    $('#msg-simple-modal-content').addClass("modal-filled");
                    $('#msg-simple-modal-content').addClass("bg-danger");
                    $('#msg-simple-modal-icon').addClass("dripicons-wrong");
                    $('#msg-simple-modal-button').addClass("btn-light");
                    break;
            }

            if (message != '') {
                $('#msg-simple-modal-message').text(message);
            }

            if (buttonText != '') {
                $('#msg-simple-modal-button').text(buttonText);
            }

            $('#msg-simple-modal-title').text(title);
            $('#msg-simple-modal').modal('toggle');
        }

        function showModalMessage(modalStyle, title, message, cancelButtonText, showButton,
            buttonText, buttonStyle) {

            switch (modalStyle) {
                case 'info':
                    $('#msg-modal-header').addClass("bg-info");
                    break;
                case 'success':
                    $('#msg-modal-header').addClass("bg-success");
                    break;
                case "warning":
                    $('#msg-modal-header').addClass("bg-warning");
                    break;
                case 'danger':
                    $('#msg-modal-header').addClass("bg-danger");
                    break;
            }

            if (title != '') {
                $('#msg-modal-title').text(title);
            }

            if (cancelButtonText != '') {
                $('#msg-modal-cancel-button').text(cancelButtonText);
            }

            if (showButton) {
                $('#msg-modal-button').show();
            }

            if (buttonText != '') {
                $('#msg-modal-button').text(buttonText);
            }

            switch (buttonStyle) {
                case 'light':
                    $('#msg-modal-button').addClass("btn-light");
                    break;
                case 'info':
                    $('#msg-modal-button').addClass("btn-info");
                    break;
                case 'success':
                    $('#msg-modal-button').addClass("btn-success");
                    break;
                case "warning":
                    $('#msg-modal-button').addClass("btn-warning");
                    break;
                case 'danger':
                    $('#msg-modal-button').addClass("btn-danger");
                    break;
            }

            $('#msg-modal-message').html(message);

            $('#msg-modal').modal('toggle');
        }

        function showConfirmModalMessage(modalStyle, title, message, cancelButtonText,
            confirmButtonText, confirmButtonStyle, cofirmFunctionName, confirmFunctionArguments,
            cancelFunctionName, cancelFunctionArguments) {

            switch (modalStyle) {
                case 'info':
                    $('#confirm-modal-header').addClass("bg-info");
                    break;
                case 'success':
                    $('#confirm-modal-header').addClass("bg-success");
                    break;
                case "warning":
                    $('#confirm-modal-header').addClass("bg-warning");
                    break;
                case 'danger':
                    $('#confirm-modal-header').addClass("bg-danger");
                    break;
            }

            if (title != '') {
                $('#confirm-modal-title').text(title);
            }

            if (cancelButtonText != '') {
                $('#confirm-modal-cancel-button').text(cancelButtonText);
            }

            if (confirmButtonText != '') {
                $('#confirm-modal-button').text(confirmButtonText);
            }

            switch (confirmButtonStyle) {
                case 'light':
                    $('#confirm-modal-button').addClass("btn-light");
                    break;
                case 'info':
                    $('#confirm-modal-button').addClass("btn-info");
                    break;
                case 'success':
                    $('#confirm-modal-button').addClass("btn-success");
                    break;
                case "warning":
                    $('#confirm-modal-button').addClass("btn-warning");
                    break;
                case 'danger':
                    $('#confirm-modal-button').addClass("btn-danger");
                    break;
            }

            $('#confirm-modal-message').html(message);

            $('#confirm-modal-button').off('click');

            if (cofirmFunctionName != '') {
                $('#confirm-modal-button').click(function () {
                    $('#confirm-modal').modal('toggle');
                    window[cofirmFunctionName](confirmFunctionArguments);
                });
            }
            else {
                $('#confirm-modal-button').click(function () {
                    $('#confirm-modal').modal('toggle');
                });
            }

            $('#confirm-modal-cancel-button').off('click');

            if (cancelFunctionName != '') {
                $('#confirm-modal-cancel-button').click(function () {
                    $('#confirm-modal').modal('toggle');
                    window[cancelFunctionName](cancelFunctionArguments);
                });
            }
            else {
                $('#confirm-modal-cancel-button').click(function () {
                    $('#confirm-modal').modal('toggle');
                });
            }

            $('#confirm-modal').modal('toggle');
        }

        var pageTitleBeforOpenningDrawer = '';

        function openBottomDrawer(href, title, height, pageTitle, drawerBackgroundColor) {

            const windowHeight = $(window).height();
            const targetHeight = windowHeight * (height / 100);

            $('#footer-drawer-content').html('');
            $('#footer-drawer-loading').show();
            $('#footer-drawer-loading').height(targetHeight - 250);
            $('#footerSlideBody').css('background-color', '#FFF');

            $('#footer-drawer-title').text(title);
            $(this).css('backgroundPosition', 'bottom left');
            $('body').css('overflow-y', 'hidden');

            pageTitleBeforOpenningDrawer = $('title').text();
            if (pageTitle != '') {
                $('title').text(pageTitle + ' | ' + pageTitleBeforOpenningDrawer.split("|")[1]);
            }

            $('#footerSlideBody').animate({ height: targetHeight + 'px' });

            $.ajax({
                type: "POST",
                url: href,
                data: {},
                contentType: "application/json",
                success: function (response) {
                    $('#footer-drawer-loading').hide();

                    if (drawerBackgroundColor != '') {
                        $('#footerSlideBody').css('background-color', drawerBackgroundColor)
                    }

                    $('#footer-drawer-content').html(response);
                },
                failure: function (response) {
                    $('#footer-drawer-loading').hide();
                    alert(response.responseText);
                },
                error: function (response) {
                    $('#footer-drawer-loading').hide();
                    alert(response.responseText);
                }
            });
        }

        function closeBottomDrawer() {
            $('#footerSlideBody').animate({ height: '0px' });
            $(this).css('backgroundPosition', 'top left');
            $('body').css('overflow-y', 'auto');
            $('title').text(pageTitleBeforOpenningDrawer);
        }

        $('#footer-drawer-close-icon').click(function () {
            closeBottomDrawer();
        });

        function showToast(toastType, title, message) {
            switch (toastType) {
                case "info":
                    toastr.info(message, title, {
                        positionClass: "toast-bottom-left",
                        timeOut: 5e3,
                        closeButton: !0,
                        debug: !1,
                        newestOnTop: !0,
                        progressBar: !0,
                        preventDuplicates: !0,
                        onclick: null,
                        showDuration: "300",
                        hideDuration: "1000",
                        extendedTimeOut: "1000",
                        showEasing: "swing",
                        hideEasing: "linear",
                        showMethod: "fadeIn",
                        hideMethod: "fadeOut",
                        tapToDismiss: !1
                    })
                    break;
                case "success":
                    toastr.success(message, title, {
                        positionClass: "toast-bottom-left",
                        timeOut: 5e3,
                        closeButton: !0,
                        debug: !1,
                        newestOnTop: !0,
                        progressBar: !0,
                        preventDuplicates: !0,
                        onclick: null,
                        showDuration: "300",
                        hideDuration: "1000",
                        extendedTimeOut: "1000",
                        showEasing: "swing",
                        hideEasing: "linear",
                        showMethod: "fadeIn",
                        hideMethod: "fadeOut",
                        tapToDismiss: !1
                    })
                    break;
                case "warning":
                    toastr.warning(message, title, {
                        positionClass: "toast-bottom-left",
                        timeOut: 5e3,
                        closeButton: !0,
                        debug: !1,
                        newestOnTop: !0,
                        progressBar: !0,
                        preventDuplicates: !0,
                        onclick: null,
                        showDuration: "300",
                        hideDuration: "1000",
                        extendedTimeOut: "1000",
                        showEasing: "swing",
                        hideEasing: "linear",
                        showMethod: "fadeIn",
                        hideMethod: "fadeOut",
                        tapToDismiss: !1
                    })
                    break;
                case "danger":
                    toastr.error(message, title, {
                        positionClass: "toast-bottom-left",
                        timeOut: 5e3,
                        closeButton: !0,
                        debug: !1,
                        newestOnTop: !0,
                        progressBar: !0,
                        preventDuplicates: !0,
                        onclick: null,
                        showDuration: "300",
                        hideDuration: "1000",
                        extendedTimeOut: "1000",
                        showEasing: "swing",
                        hideEasing: "linear",
                        showMethod: "fadeIn",
                        hideMethod: "fadeOut",
                        tapToDismiss: !1
                    })
                    break;
            }
        }
    </script>
