@model Web.Model.CommissionRuleViewModel

@{
    ViewData["PageTitle"] = "ثبت قانون جدید برای محاسبه پورسانت";
}

<div style="margin-top:-14px;">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { name = "my-form", id = "my-form" }))
    {
        <input type="hidden" id="IsDeleted" name="IsDeleted" value="false" />

        <div class="container-card padding30" style="padding-top:45px;">
            <div class="form-horizontal">
                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.CommissionBasedOn, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @(Html.Kendo().DropDownList()
                            .Name("CommissionBasedOn")
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .OptionLabel("انتخاب کنید")
                            .HtmlAttributes(new { style = "width: 100%" })
                            .BindTo(new List<SelectListItem>() {
                                new SelectListItem() {
                                Text = "تعداد ثبت نام",
                                Value = "1"
                                },
                                new SelectListItem() {
                    Text = "مبلغ ثبت نام",
                                Value = "2"
                                }
                                }).Events(e =>
                                {
                                    e.Change("onCommissionBasedOnComboChange");
                                }))
                        @Html.ValidationMessageFor(model => model.CommissionBasedOn, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-7 col-sm-5">
                        <span style="color:red;font-size:20px;">*</span>
                    </div>
                </div>

                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.CommissionType, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @(Html.Kendo().DropDownList()
                            .Name("CommissionType")
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .OptionLabel("انتخاب کنید")
                            .HtmlAttributes(new { style = "width: 100%" })
                            .BindTo(new List<SelectListItem>() {
                                new SelectListItem() {
                                Text = "پورسانت درصدی",
                                Value = "1"
                                },
                                new SelectListItem() {
                                Text = "پورسانت به ازای هر ثبت نام",
                                Value = "2"
                                }
                                }))
                        @Html.ValidationMessageFor(model => model.CommissionType, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-7 col-sm-5">
                        <span style="color:red;font-size:20px;">*</span>
                    </div>
                </div>
                <div id="number-div" style="display:none;">
                    <div class="row form-group" style="margin-top:30px;">
                        @Html.LabelFor(model => model.MinimumNumber, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                        <div class="col-md-3 col-sm-4">
                            @Html.EditorFor(model => model.MinimumNumber)
                            @Html.ValidationMessageFor(model => model.MinimumNumber, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-7 col-sm-5">
                            <span style="color:red;font-size:20px;">*</span>
                        </div>
                    </div>
                    <div class="row form-group" style="margin-top:30px;">
                        @Html.LabelFor(model => model.MaximumNumber, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                        <div class="col-md-3 col-sm-4">
                            @Html.EditorFor(model => model.MaximumNumber)
                            @Html.ValidationMessageFor(model => model.MaximumNumber, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-7 col-sm-5">
                            <span style="color:red;font-size:20px;">*</span>
                        </div>
                    </div>
                </div>
                <div id="amount-div" style="display:none;">
                    <div class="row form-group" style="margin-top:30px;">
                        @Html.LabelFor(model => model.MinimumAmount, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                        <div class="col-md-3 col-sm-4">
                            @Html.EditorFor(model => model.MinimumAmount)
                            @Html.ValidationMessageFor(model => model.MinimumAmount, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-7 col-sm-5">
                            <span style="color:red;font-size:20px;">*</span>
                        </div>
                    </div>
                    <div class="row form-group" style="margin-top:30px;">
                        @Html.LabelFor(model => model.MaximumAmount, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                        <div class="col-md-3 col-sm-4">
                            @Html.EditorFor(model => model.MaximumAmount)
                            @Html.ValidationMessageFor(model => model.MaximumAmount, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-7 col-sm-5">
                            <span style="color:red;font-size:20px;">*</span>
                        </div>
                    </div>
                </div>
                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.Value, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @Html.EditorFor(model => model.Value)
                        @Html.ValidationMessageFor(model => model.Value, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-7 col-sm-5">
                        <span style="color:red;font-size:20px;">*</span>
                    </div>
                </div>
                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.Active, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @(Html.Kendo().DropDownList()
                            .Name("Active")
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .OptionLabel("انتخاب کنید")
                            .HtmlAttributes(new { style = "width: 100%" })
                            .SelectedIndex(1)
                            .BindTo(new List<SelectListItem>() {
                                new SelectListItem() {
                                Text = "فعال",
                                Value = "True"
                                },
                                new SelectListItem() {
                                Text = "غیرفعال",
                                Value = "False"
                                }
                                }))
                        @Html.ValidationMessageFor(model => model.Active, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-7 col-sm-5">
                        <span style="color:red;font-size:20px;">*</span>
                    </div>
                </div>
                <hr style="margin-top:45px;color:orangered;" />
                <div class="row" style="margin-top:12px;">
                    <div class="col-md-6 col-sm-12">
                        <input type="button" id="btn-submit" class="btn btn-success form-command-btn" value="ذخیره" style="float:right;" />
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <a href=@Url.Action("Index", "CommissionRule", new { Area = "Admin" }) class="btn btn-danger form-command-btn" style="float: left;">بازگشت</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model != null)
{
    if (Model.CommissionBasedOn == 1)
    {
        <script>
            $(document).ready(function () {
                $('#amount-div').hide();
                $('#number-div').show();
            });
        </script>
    }
    else
    {
        <script>
            $(document).ready(function () {
                $('#number-div').hide();
                $('#amount-div').show();
            });
        </script>
    }
}

<script>
    function onCommissionBasedOnComboChange() {
        if ($('#CommissionBasedOn').val() == '1') {
            $('#amount-div').hide();
            $('#number-div').show();
        }
        else {
            $('#number-div').hide();
            $('#amount-div').show();
        }
    }

    $('#btn-submit').click(function () {
        if ($('#CommissionBasedOn').val() == '1') {
            if($('#MinimumNumber').val() != ''){
                if ($('#MaximumNumber').val() != '') {

                    $('#MinimumAmount').val('');
                    $('#MaximumAmount').val('');

                    $('#my-form').submit();
                }
                else{
                    showSimpleModalMessage('danger', 'خطا', 'حداکثر تعداد ثبت نام مشخص نشده است', 'متوجه شدم');
                }
            }
            else{
                showSimpleModalMessage('danger', 'خطا', 'حداقل تعداد ثبت نام مشخص نشده است', 'متوجه شدم');
            }
        }
        else if ($('#CommissionBasedOn').val() == '2'){
            if ($('#MinimumAmount').val() != '') {
                if ($('#MaximumAmount').val() != '') {

                    $('#MinimumNumber').val('');
                    $('#MaximumNumber').val('');

                    $('#my-form').submit();
                }
                else {
                    showSimpleModalMessage('danger', 'خطا', 'حداکثر مبلغ ثبت نام مشخص نشده است', 'متوجه شدم');
                }
            }
            else {
                showSimpleModalMessage('danger', 'خطا', 'حداقل مبلغ ثبت نام مشخص نشده است', 'متوجه شدم');
            }
        }
        else{
            showSimpleModalMessage('danger', 'خطا', 'روش محاسبه پورسانت نامعتبر است', 'متوجه شدم');
        }
    });
</script>
