@using DbEntities
@model Web.Model.InterviewAppointmentViewModel
@{
    ViewData["PageTitle"] = "ویرایش مصاحبه استخدامی";
}

<div style="margin-top:-14px;">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { name = "my-form", id = "my-form" }))
    {
        @Html.HiddenFor(m => m.JobAnnouncementId)
        @Html.HiddenFor(m => m.InterviewAppointmentId)
        @Html.HiddenFor(m => m.JobAnnouncementTitle)

        <div class="container-card padding30" style="padding-top:45px;">
            <div class="form-horizontal">

                <div class="row form-group" style="margin-top:30px;">
                    @Html.Label(null, "داوطلب", htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @Html.Hidden("ApplicantId")
                        @Html.TextBox("ApplicantFullName", "", new { @readonly = "readonly", @class = "form-control" })
                    </div>
                    <div class="col-md-1 col-sm-2" style="margin-right:-20px;">
                        <a class="btn btn-info modal-link" href=@Url.Action("ShowApplicantSearchDialog",
                                                                            "Applicant", new { Area = "Admin", valueElementId = "ApplicantId",
                                                                                                 displayElementId = "ApplicantFullName" })
                           style="box-shadow:none;border-radius:0.4rem;height:40px;font-size:20px;padding-top:6px;">
                            <i class="uil-search"></i>
                        </a>
                    </div>
                </div>

                <div class="row form-group" style="margin-top:30px;">
                    <div class="col-md-4 col-sm-12">
                        @Html.LabelFor(m => m.Status, htmlAttributes: new { @class = "control-label form-input-label" })
                    </div>
                    <div class="col-md-6 col-sm-10 col-12">
                        @(Html.Kendo().DropDownListFor(m => m.Status)
                                            .HtmlAttributes(new { style = "width:100%" })
                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .BindTo(new List<SelectListItem>()
                                            {
                                        new SelectListItem() { Text = "درحال بررسی", Value = "1" },
                                        new SelectListItem() { Text = "تأیید شده", Value = "2" },
                                        new SelectListItem() { Text = "لغو شده", Value = "3" },
                                        new SelectListItem() { Text = "تکمیل شده", Value = "4" }
                                            })
                                            )
                    @Html.ValidationMessageFor(m => m.Status, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-2 col-sm-2 col-12">
                    <span style="color:red;font-size:20px;">*</span>
                </div>
            </div>

            </div>


            <hr style="margin-top:45px;color:orangered;" />

            <div class="row" style="margin-top:12px;">
                <div class="col-md-6 col-sm-12">
                    <input type="submit" class="btn btn-success form-command-btn" value="ذخیره" style="float:right;" />
                </div>
                <div class="col-md-6 col-sm-12">
                    <a href="@Url.Action("Index", "InterviewAppointment", new { Area = "Admin", jobAnnouncementId = Model.JobAnnouncementId })"
                       class="btn btn-danger form-command-btn" style="float:left;">بازگشت</a>
                </div>
            </div>
        </div>
        }
</div>
