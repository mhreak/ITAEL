@model IEnumerable<ApplicantViewModel>

@{
    ViewData["PageTitle"] = "لیست داوطلبین";
}

<div class="accordion" id="custom-accordion-one" style="margin-top:-14px;">
    <div class="card mb-0">
        <div class="card-header" id="headingOne" style="max-height:40px;padding-top:0px;border-radius:4px;">
            <h5 class="m-0">
                <a class="custom-accordion-title d-block pt-2 pb-2 collapsed"
                   data-bs-toggle="collapse" href="#collapseOne"
                   aria-expanded="true" aria-controls="collapseOne">
                    <i class="uil uil-filter" style="color:orangered;"></i>
                    <b style="font-size:16px;margin-right:5px;">فیلتر اطلاعات</b>
                    <i class="mdi mdi-chevron-up accordion-arrow" style="float:left;color:orangered;"></i>
                </a>
            </h5>
        </div>

        <div id="collapseOne" class="collapse"
             aria-labelledby="headingOne" data-bs-parent="#accordionExample">
            <div class="card-body">
                <div class="row" style="margin-top:22px;">
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "نام و نام خانوادگی", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                @Html.Editor("FilterFullName")
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "کد ملی", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                @Html.Editor("FilterNationalCode")
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row" style="margin-top:22px;">
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "تلفن همراه", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                @Html.Editor("FilterMobile")
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "جنسیت", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                @(Html.Kendo().DropDownList()
                                    .Name("FilterGender")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .OptionLabel("همه")
                                    .HtmlAttributes(new { style = "width: 100%" })
                                    .BindTo(new List<SelectListItem>() {
                                        new SelectListItem() {
                                        Text = "آقا",
                                        Value = "true"
                                        },
                                        new SelectListItem() {
                                        Text = "خانم",
                                        Value = "false"
                                        }
                                        }))
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row" style="margin-top:22px;">
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "استان", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                @(Html.Kendo().DropDownList()
                                    .Name("FilterProvinceId")
                                    .OptionLabel("همه")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .DataSource(source =>
                                    {
                                        source.Read(read =>
                                        {
                                            read.Action("Fill_Province_Combo", "Province", new { Area = "Admin" });
                                        });
                                    })
                                    )
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "شهرستان مشتری", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                @(Html.Kendo().DropDownList()
                                    .Name("FilterCityId")
                                    .OptionLabel("همه")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .DataSource(source =>
                                    {
                                        source.Read(read =>
                                        {
                                            read.Action("Fill_City_Combo", "City", new { Area = "Admin" })
                                        .Data("filterCities");
                                        })
                                        .ServerFiltering(true);
                                    })
                                    .Enable(false)
                                    .AutoBind(false)
                                    .CascadeFrom("FilterProvinceId")
                                    )
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row" style="margin-top:22px;">
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "تاریخ تولد از", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                <div>
                                    <div style="display:inline-block;width:100%;">
                                        <input type="text" class="form-control" id="FilterBirthDateFrom" name="FilterBirthDateFrom"
                                               data-ha-datetimepicker="#FilterBirthDateFrom" data-ha-dp-issolar="true"
                                               data-ha-dp-disabletime="true" data-ha-dp-resultinsolar="true"
                                               data-ha-dp-resultformat="{year}/{month}/{day}"
                                               value="" style="display:inline;" />
                                    </div>
                                    <div style="display:inline-block;margin-right:-30px;">
                                        <i class="fa fa-calendar" style="color: #034ea2;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "تاریخ تولد تا", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                <div>
                                    <div style="display:inline-block;width:100%;">
                                        <input type="text" class="form-control" id="FilterBirthDateTo" name="FilterBirthDateTo"
                                               data-ha-datetimepicker="#FilterBirthDateTo" data-ha-dp-issolar="true"
                                               data-ha-dp-disabletime="true" data-ha-dp-resultinsolar="true"
                                               data-ha-dp-resultformat="{year}/{month}/{day}" value="" style="display:inline;" />
                                    </div>
                                    <div style="display:inline-block;margin-right:-30px;">
                                        <i class="fa fa-calendar" style="color: #034ea2;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row" style="margin-top:22px;">
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "تاریخ ثبت از", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                <div>
                                    <div style="display:inline-block;width:100%;">
                                        <input type="text" class="form-control" id="FilterInsertDateFrom" name="FilterInsertDateFrom"
                                               data-ha-datetimepicker="#FilterInsertDateFrom" data-ha-dp-issolar="true"
                                               data-ha-dp-disabletime="true" data-ha-dp-resultinsolar="true"
                                               data-ha-dp-resultformat="{year}/{month}/{day}" value="" style="display:inline;" />
                                    </div>
                                    <div style="display:inline-block;margin-right:-30px;">
                                        <i class="fa fa-calendar" style="color: #034ea2;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "تاریخ ثبت تا", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                <div>
                                    <div style="display:inline-block;width:100%;">
                                        <input type="text" class="form-control" id="FilterInsertDateTo" name="FilterInsertDateTo"
                                               data-ha-datetimepicker="#FilterInsertDateTo" data-ha-dp-issolar="true"
                                               data-ha-dp-disabletime="true" data-ha-dp-resultinsolar="true"
                                               data-ha-dp-resultformat="{year}/{month}/{day}" value="" style="display:inline;" />
                                    </div>
                                    <div style="display:inline-block;margin-right:-30px;">
                                        <i class="fa fa-calendar" style="color: #034ea2;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row" style="margin-top:22px;">
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "رشته تحصیلی", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                @(Html.Kendo().DropDownList()
                                    .Name("FilterStudyFieldId")
                                    .OptionLabel("همه")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .DataSource(source =>
                                    {
                                        source.Read(read =>
                                        {
                                            read.Action("Fill_StudyField_Combo", "StudyField", new { Area = "Admin", active = "" });
                                        });
                                    })
                                    )
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                        </div>
                    </div>
                </div>
                <hr style="margin-top:22px;" />
                <a class="btn btn-info" style="float:left;margin-bottom:10px;" onclick="filterData()">فیلتر اطلاعات</a>

            </div>
        </div>
    </div>

    <div class="k-rtl" style="margin-top:20px;">
        <div style="height:100%;">
            @(
                Html.Kendo().Grid<ApplicantViewModel>().Name("Grid").Columns(columns =>
                {
                    columns.Bound(c => c.FullName).Width(250);
                    columns.Bound(c => c.NationalCode).Width(200);
                    columns.Bound(c => c.Mobile).Width(220);
                    columns.Bound(c => c.ProvinceName).Width(220);
                    columns.Bound(c => c.CityName).Width(220);
                    columns.Bound(c => c.ShamsiBirthDate).Width(220);
                    columns.Bound(c => c.ShamsiInsertDate).Width(220);

                    columns.Command(command =>
                    {
                        command.Custom("ویرایش").Click("editRow").HtmlAttributes(new { @class = "command-btn-yellow" });

                        command.Custom("حذف").Click("deleteRow").HtmlAttributes(new { @class = "command-btn-red" });

                    }).Width(400);
                })
                .HtmlAttributes(new { style = "height: 550px;border-radius:0.25rem;" })
                .Filterable(ftb => ftb.Mode(GridFilterMode.Menu))
                .Scrollable(scrollable => scrollable.Virtual(true))
                .Sortable()
                .Pageable(pageable => pageable
                .Refresh(true)
                .PageSizes(true)
                .ButtonCount(5))
                .DataSource(dataSource => dataSource
                .Ajax()
                .Events(events => events.Error("error_handler"))
                .Model(model =>
                {
                    model.Id(x => x.ApplicantId);
                })
                .Read(read => read.Action("Grid_Data_Read", "Applicant", new { Area = "Admin" })
                .Data("getFilterDataParams"))
                .PageSize(20)
                )
                )
        </div>
    </div>
    <div class="row" style="margin-top:20px;">
        <div class="col-xs-6 col-sm-6 col-md-6">
            <a href="@Url.Action("Create", "Applicant")" class="btn btn-success form-command-btn" style="display:inline-block;float:right;">
                <span><i class="fa fa-plus"></i><span>&nbsp;</span>ثبت جدید</span>
            </a>
        </div>
        <div class="col-xs-6 col-sm-6 col-md-6 text-left">
            @* <a href="@Url.Action("Index", "Dashboard")" class="btn btn-info form-command-btn" style="float:left;">
            <span class="btn-label"><i class="fa fa-reply"></i><span>&nbsp;</span>بازگشت</span>
            </a> *@
        </div>
    </div>
</div>

<script type="text/javascript">

    function editRow(e) {
        e.preventDefault();
        var dataItem = this.dataItem(jQuery(e.currentTarget).closest("tr"));
        window.location.href = "/Admin/Applicant/Edit/" + dataItem.ApplicantId;
    }

    function filterCities() {
        return {
            provinceId: $("#FilterProvinceId").val()
        };
    }


    var getFilterDataParams = function (e) {
        var result = {
            filterFullName: $('#FilterFullName').val(),
            filterNationalCode: $('#FilterNationalCode').val(),
            filterMobile: $('#FilterMobile').val(),
            filterGender: $('#FilterGender').val(),
            filterProvinceId: $('#FilterProvinceId').val(),
            filterCityId: $('#FilterCityId').val(),
            filterBirthDateFrom: $('#FilterBirthDateFrom').val(),
            filterBirthDateTo: $('#FilterBirthDateTo').val(),
            filterInsertDateFrom: $('#FilterInsertDateFrom').val(),
            filterInsertDateTo: $('#FilterInsertDateTo').val(),
            filterStudyFieldId: $('#FilterStudyFieldId').val(),
        }
        return result;
    };

    function filterData() {
        $("#Grid").data("kendoGrid").dataSource.read();
    }

    function deleteRow(e) {
        var dataItem = this.dataItem(jQuery(e.currentTarget).closest("tr"));
        $.ajax({
            url: '/Admin/Applicant/Delete',
            type: "GET",
            data: {
                id: dataItem.ApplicantId
            }
        }).done(function (dresult) {
            if (dresult == true) {
                var reqGrid = $("#Grid").data("kendoGrid");
                reqGrid.dataSource.read();
                showSimpleModalMessage('success', 'عملیات انجام شد', 'اطلاعات موردنظر حذف شد', '');
            }
            else {
                showSimpleModalMessage('danger', 'خطا', 'امکان حذف این اطلاعات وجود ندارد', '');
            }
        })
    }
</script>