@model List<Web.Areas.Admin.Controllers.ApplicantExamQuestionAndAnswerForAdminViewModel>

<header>
    <link rel="stylesheet" href="~/css/style/styles.css">
</header>

@* Anti-forgery token برای ارسال ایمن درخواست‌های POST از JS *@
@Html.AntiForgeryToken()

<section id="exam-review" class="review-box section-box" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="headerrev-text">
            <h5 class="m-0"><b>نتایج و تصحیح آزمون</b></h5>
            <small class="text-body-secondary">مرور پاسخ‌های @ViewBag.ApplicantFullName برای آزمون @ViewBag.ExamTitle</small>
        </div>
        <span class="badge rounded-pill px-3 py-2" style="background:rgba(83,73,248,.08);color:var(--primary);border:1px solid rgba(83,73,248,.2); margin-left:20px; margin-top:5px;">@ViewBag.JobAnnouncementTitle</span>
    </div>

    @* از for استفاده می‌کنیم تا index در JS در دسترس باشد *@
    @for (int i = 0; i < Model.Count; i++)
    {
        var item = Model[i];

        if (item.ExamQuestionViewModel.Type == 1)
        {
            <article class="review-card mcq-review"
                     data-correct="@item.ExamQuestionViewModel.ExamQuestionOptionViewModelList!.FirstOrDefault(x => x.IsCorrectAnswer)!.ExamQuestionOptionId"
                     data-user="@item.ApplicantExamQuestionAnswerViewModel.ExamQuestionOptionId">
                <div class="q-header">
                    <span class="q-index">@item.ExamQuestionViewModel.QuestionOrder</span>
                    <span class="q-type">@item.ExamQuestionViewModel.TypeStr</span>
                </div>

                <div class="q-stem">@item.ExamQuestionViewModel.Text</div>

                <div class="options">
                    @foreach (var option in item.ExamQuestionViewModel.ExamQuestionOptionViewModelList)
                    {
                        <label class="option" data-key="@option.ExamQuestionOptionId">
                            <input type="radio" disabled>
                            <span class="o-text">@option.Title</span>
                        </label>
                    }

                    <div class="legend">
                        <span class="chip chip-correct">پاسخ صحیح</span>
                        <span class="chip chip-wrong">پاسخ شما</span>
                        <span class="o-text">نمره: @item.ApplicantExamQuestionAnswerViewModel.Grade از @item.ExamQuestionViewModel.Grade</span>
                    </div>
                </div>
            </article>
        }
        else
        {
            @* بلوک تشریحی — اینجا فیلدها ویرایشی می‌شوند *@
            <article class="review-card essay-review correction-item" data-index="@i">
                <div class="q-header">
                    <span class="q-index">@item.ExamQuestionViewModel.QuestionOrder</span>
                    <span class="q-type">@item.ExamQuestionViewModel.TypeStr</span>
                </div>

                <div class="q-stem">
                    @item.ExamQuestionViewModel.Text
                </div>

                <div class="essay-block">
                    <div class="essay-section">
                        <h6 class="essay-title">
                            <i class="bi bi-person-voice me-1"></i> پاسخ داوطلب
                        </h6>
                        <p class="essay-answer user-answer">
                            @item.ApplicantExamQuestionAnswerViewModel.AnswerText
                        </p>
                    </div>

                    <div class="essay-section">
                        <h6 class="essay-title">
                            <i class="bi bi-check2-circle me-1"></i> پاسخ درست و پیشنهادی
                        </h6>
                        <p class="essay-answer model-answer">
                            @item.ExamQuestionViewModel.AnswerText
                        </p>
                    </div>

                    <div class="essay-section">
                        <h6 class="essay-title">
                            <i class="bi bi-journal-text me-1"></i> نکات تکمیلی مصحح
                        </h6>
                        @* textarea قابل ویرایش برای AdditionalCorrectionTips *@
                        <div class="review-notes">
                            <textarea class="form-control correction-tips" style="height: 250px;" data-index="@i" name="tips-@i">
                                @Html.Raw(item.ApplicantExamQuestionAnswerViewModel.AdditionalCorrectionTips ?? "")
                            </textarea>
                        </div>
                    </div>

                    <div class="essay-section">
                        <h6 class="essay-title">
                            <i class="bi bi-journal-text me-1"></i> نمره
                        </h6>
                        @* ورودی قابل ویرایش برای Grade *@
                        <div class="review-notes d-flex align-items-center gap-2">
                            <input type="number" step="0.1" min="0" max="@item.ExamQuestionViewModel.Grade" class="form-control correction-grade" style="width:120px;" data-index="@i" name="grade-@i" value="@(item.ApplicantExamQuestionAnswerViewModel.Grade.ToString() ?? "")" />
                            <small class="text-muted">/ نمره</small>
                        </div>
                    </div>

                    @* مخفی: id جواب (اگر در ViewModel وجود دارد) — اگر ندارید، مقدار خالی می‌ماند و JS از index استفاده می‌کند *@
                    @* <input type="hidden" class="applicantExamAttempt-id" data-index="@i" value="@(item.ApplicantExamQuestionAnswerViewModel.ApplicantExamAttemptId)" /> *@
                    <input type="hidden" class="examQuestion-id" data-index="@i" value="@(item.ApplicantExamQuestionAnswerViewModel.ExamQuestionId)" />
                </div>
            </article>
        }
    }

    @* دکمه‌های ذخیره و بازگشت در پایین صفحه *@
    <div class="mt-4 d-flex gap-2">
        <button id="btnSaveCorrections" class="btn btn-primary">ثبت و ذخیره</button>
        <a asp-area="Admin" asp-controller="ApplicantExamAttempt" asp-action="Index" asp-route-applicantId="@ViewBag.ApplicantId" asp-route-jobAnnouncementId="@ViewBag.JobAnnouncementId" class="btn btn-secondary ms-auto">بازگشت</a>

        <div id="saveStatus" class="align-self-center ms-3" style="display:none;">
            <span id="saveMessage"></span>
        </div>
    </div>
</section>

<script>
        (function () {
        // مسیر صحیح کنترلر: نام کنترلر = ApplicantExamQuestionAnswer
        const saveUrl = '/Admin/ApplicantExamQuestionAnswer/Update/' + @ViewBag.ApplicantExamAttemptId + '/' + @ViewBag.JobAnnouncementId;

        const btnSave = document.getElementById('btnSaveCorrections');
        const saveStatus = document.getElementById('saveStatus');
        const saveMessage = document.getElementById('saveMessage');

        function getRequestVerificationToken() {
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : null;
        }

        btnSave.addEventListener('click', async function (e) {
            e.preventDefault();

            const items = Array.from(document.querySelectorAll('.correction-item'));
            const payloadCorrections = [];

            items.forEach(it => {
                const idx = it.getAttribute('data-index');
                const tipsEl = document.querySelector('.correction-tips[data-index="' + idx + '"]');
                const gradeEl = document.querySelector('.correction-grade[data-index="' + idx + '"]');
                const examQuestionIdEl = document.querySelector('.examQuestion-id[data-index="' + idx + '"]');

                const obj = {
                    index: idx ? parseInt(idx, 10) : null,
                    examQuestionId: examQuestionIdEl ? (parseInt(examQuestionIdEl.value, 10) || null) : null,
                    additionalCorrectionTips: tipsEl ? tipsEl.value.trim() : '',
                    grade: gradeEl && gradeEl.value !== '' ? parseFloat(gradeEl.value) : null
                };

                payloadCorrections.push(obj);
            });

            saveStatus.style.display = 'inline-block';
            saveMessage.textContent = 'در حال ارسال...';

            try {
                const token = getRequestVerificationToken();

                const res = await fetch(saveUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token  // ASP.NET می‌تواند این هدر را بخواند
                    },
                    body: JSON.stringify({
                        Corrections: payloadCorrections,
                        ApplicantExamAttemptId: @ViewBag.ApplicantExamAttemptId,
                        JobAnnouncementId: @ViewBag.JobAnnouncementId
                    })
                });

                if (!res.ok) {
                    const txt = await res.text();
                    throw new Error('خطا در سمت سرور: ' + res.status + ' ' + txt);
                }

                const data = await res.json();
                if (data && data.success) {
                    saveMessage.textContent = data.message || 'ذخیره با موفقیت انجام شد.';
                } else {
                    saveMessage.textContent = (data && data.message) ? data.message : 'خطا در ذخیره.';
                }
            } catch (err) {
                console.error(err);
                saveMessage.textContent = 'خطا در ذخیره: ' + (err.message || err);
            } finally {
                setTimeout(() => { saveStatus.style.display = 'none'; }, 4000);
            }
        });
    })();
</script>

<script>   
        (function(){
            // MCQ review painter
                document.querySelectorAll('.mcq-review').forEach(card => {
                    const correctKey = card.dataset.correct?.trim();
                    const userKey    = card.dataset.user?.trim();

                    card.querySelectorAll('.option').forEach(opt => {
                        const key = opt.dataset.key?.trim();
                        const dot = opt.querySelector('input[type="radio"]');

                        // رادیوها فقط نمایشی هستند
                        if (dot) dot.disabled = true;

                        // پاسخ صحیح: همیشه سبز
                        if (key === correctKey) {
                            opt.classList.add('correct');
                            if (dot) dot.checked = true; // نشانگر سبز
                        }

                        // اگر کاربر اشتباه زده، پاسخ او را قرمز کن
                        if (userKey && userKey !== correctKey && key === userKey) {
                            opt.classList.add('wrong');
                            if (dot) dot.checked = true; // نشانگر قرمز (با کلاس wrong)
                        }
                        });
                });
            })();
    </script>