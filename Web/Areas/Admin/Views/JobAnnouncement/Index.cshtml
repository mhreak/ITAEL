@model IEnumerable<JobAnnouncementViewModel>

@{
    ViewData["PageTitle"] = "لیست آگهی ها";
}

<div class="accordion" id="custom-accordion-one" style="margin-top:-14px;">
    <div class="card mb-0">
        <div class="card-header" id="headingOne" style="max-height:40px;padding-top:0px;border-radius:4px;">
            <h5 class="m-0">
                <a class="custom-accordion-title d-block pt-2 pb-2 collapsed"
                   data-bs-toggle="collapse" href="#collapseOne"
                   aria-expanded="true" aria-controls="collapseOne">
                    <i class="uil uil-filter" style="color:orangered;"></i>
                    <b style="font-size:16px;margin-right:5px;">فیلتر اطلاعات</b>
                    <i class="mdi mdi-chevron-up accordion-arrow" style="float:left;color:orangered;"></i>
                </a>
            </h5>
        </div>

        <div id="collapseOne" class="collapse"
             aria-labelledby="headingOne" data-bs-parent="#accordionExample">
            <div class="card-body">
                <div class="row" style="margin-top:22px;">
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "عنوان", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                @Html.Editor("FilterTitle")
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "جنسیت", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                @(Html.Kendo().DropDownList()
                                                                .Name("FilterGender")
                                                                .DataTextField("Text")
                                                                .DataValueField("Value")
                                                                .OptionLabel("همه")
                                                                .HtmlAttributes(new { style = "width: 100%" })
                                                                .BindTo(new List<SelectListItem>() {
                                                                new SelectListItem() {
                                                                Text = "آقا",
                                                                Value = "true"
                                                                },
                                                                new SelectListItem() {
                                                                Text = "خانم",
                                                                Value = "false"
                                                                }
                                                                }))
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row" style="margin-top:22px;">
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "تاریخ انتشار از", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                <div>
                                    <div style="display:inline-block;width:100%;">
                                        <input type="text" class="form-control" id="FilterPublishDateFrom" name="FilterPublishDateFrom"
                                               data-ha-datetimepicker="#FilterPublishDateFrom" data-ha-dp-issolar="true"
                                               data-ha-dp-disabletime="true" data-ha-dp-resultinsolar="true"
                                               data-ha-dp-resultformat="{year}/{month}/{day}"
                                               value="" style="display:inline;" />
                                    </div>
                                    <div style="display:inline-block;margin-right:-30px;">
                                        <i class="fa fa-calendar" style="color: #034ea2;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "تاریخ انتشار تا", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                <div>
                                    <div style="display:inline-block;width:100%;">
                                        <input type="text" class="form-control" id="FilterPublishDateTo" name="FilterPublishDateTo"
                                               data-ha-datetimepicker="#FilterPublishDateTo" data-ha-dp-issolar="true"
                                               data-ha-dp-disabletime="true" data-ha-dp-resultinsolar="true"
                                               data-ha-dp-resultformat="{year}/{month}/{day}" value="" style="display:inline;" />
                                    </div>
                                    <div style="display:inline-block;margin-right:-30px;">
                                        <i class="fa fa-calendar" style="color: #034ea2;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row" style="margin-top:22px;">
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "ظرفیت از", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                @Html.Editor("FilterCapacityFrom")
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "ظرفیت تا", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                @Html.Editor("FilterCapacityTo")
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row" style="margin-top:22px;">
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "آزمون", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                @(Html.Kendo()
                                                                .DropDownList()
                                                                .Name("FilterHasEmploymentExam")
                                                                .DataTextField("Text")
                                                                .DataValueField("Value")
                                                                .OptionLabel("همه")
                                                                .HtmlAttributes(new { style = "width: 100%" })
                                                                .BindTo(new List<SelectListItem>() { new SelectListItem() { Text = "دارد", Value = "True" }, new SelectListItem() { Text = "ندارد", Value = "False" } }))
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "وضعیت", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                @(Html.Kendo()
                                                                .DropDownList()
                                                                .Name("FilterActive")
                                                                .DataTextField("Text")
                                                                .DataValueField("Value")
                                                                .OptionLabel("همه")
                                                                .HtmlAttributes(new { style = "width: 100%" })
                                                                .BindTo(new List<SelectListItem>() { new SelectListItem() { Text = "فعال", Value = "True" }, new SelectListItem() { Text = "غیرفعال", Value = "False" } }))
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row" style="margin-top:22px;">
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "تاریخ آزمون از", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                <div>
                                    <div style="display:inline-block;width:100%;">
                                        <input type="text" class="form-control" id="FilterPublishDateFrom" name="FilterPublishDateFrom"
                                               data-ha-datetimepicker="#FilterPublishDateFrom" data-ha-dp-issolar="true"
                                               data-ha-dp-disabletime="true" data-ha-dp-resultinsolar="true"
                                               data-ha-dp-resultformat="{year}/{month}/{day}"
                                               value="" style="display:inline;" />
                                    </div>
                                    <div style="display:inline-block;margin-right:-30px;">
                                        <i class="fa fa-calendar" style="color: #034ea2;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "تاریخ آزمون تا", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                <div>
                                    <div style="display:inline-block;width:100%;">
                                        <input type="text" class="form-control" id="FilterPublishDateTo" name="FilterPublishDateTo"
                                               data-ha-datetimepicker="#FilterPublishDateTo" data-ha-dp-issolar="true"
                                               data-ha-dp-disabletime="true" data-ha-dp-resultinsolar="true"
                                               data-ha-dp-resultformat="{year}/{month}/{day}" value="" style="display:inline;" />
                                    </div>
                                    <div style="display:inline-block;margin-right:-30px;">
                                        <i class="fa fa-calendar" style="color: #034ea2;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row" style="margin-top:22px;">
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "تاریخ ثبت از", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                <div>
                                    <div style="display:inline-block;width:100%;">
                                        <input type="text" class="form-control" id="FilterInsertDateFrom" name="FilterInsertDateFrom"
                                               data-ha-datetimepicker="#FilterInsertDateFrom" data-ha-dp-issolar="true"
                                               data-ha-dp-disabletime="true" data-ha-dp-resultinsolar="true"
                                               data-ha-dp-resultformat="{year}/{month}/{day}" value="" style="display:inline;" />
                                    </div>
                                    <div style="display:inline-block;margin-right:-30px;">
                                        <i class="fa fa-calendar" style="color: #034ea2;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="row form-group">
                            @Html.Label(null, "تاریخ ثبت تا", htmlAttributes: new { @class = "form-input-label col-md-3 col-sm-12", style = "float:right;text-align:right;margin-top:8px;" })
                            <div class="col-md-6 col-sm-12">
                                <div>
                                    <div style="display:inline-block;width:100%;">
                                        <input type="text" class="form-control" id="FilterInsertDateTo" name="FilterInsertDateTo"
                                               data-ha-datetimepicker="#FilterInsertDateTo" data-ha-dp-issolar="true"
                                               data-ha-dp-disabletime="true" data-ha-dp-resultinsolar="true"
                                               data-ha-dp-resultformat="{year}/{month}/{day}" value="" style="display:inline;" />
                                    </div>
                                    <div style="display:inline-block;margin-right:-30px;">
                                        <i class="fa fa-calendar" style="color: #034ea2;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <hr style="margin-top:22px;" />
                <a class="btn btn-info" style="float:left;margin-bottom:10px;" onclick="filterData()">فیلتر اطلاعات</a>

            </div>
        </div>
    </div>

    <div class="k-rtl" style="margin-top:20px;">
        <div style="height:100%;">
            @(
                        Html.Kendo().Grid<JobAnnouncementViewModel>().Name("Grid").Columns(columns =>
                        {
                            columns.Bound(c => c.Title).Width(250);
                            columns.Bound(c => c.GenderStr).Width(200);
                            columns.Bound(c => c.ShamsiPublishDate).Width(220);
                            columns.Bound(c => c.Capacity).Width(220);
                            columns.Bound(c => c.HasEmploymentExam).Width(220);
                            columns.Bound(c => c.ShamsiExamDate).Width(220);
                            columns.Bound(c => c.ShamsiInsertDate).Width(220);
                            columns.Bound(c => c.ActiveStr).Width(220);

                            columns.Command(command =>
                            {
                                command.Custom("منوی عملیات").Click("showAnnouncementOperationMenu").HtmlAttributes(new { @class = "command-btn-blue" });

                                command.Custom("حذف").Click("deleteRow").HtmlAttributes(new { @class = "command-btn-red" });

                                @*                                 command.Custom("نمایش قرارهای مصاحبه").Click("interviewAppointmentListRow").HtmlAttributes(new { @class = "command-btn-blue" });

                                command.Custom("نمایش آزمون ها").Click("examListRow").HtmlAttributes(new { @class = "command-btn-blue" }); *@

                            }).Width(400);
                        })
                        .HtmlAttributes(new { style = "height: 550px;border-radius:0.25rem;" })
                        .Filterable(ftb => ftb.Mode(GridFilterMode.Menu))
                        .Scrollable(scrollable => scrollable.Virtual(true))
                        .Sortable()
                        .Pageable(pageable => pageable
                        .Refresh(true)
                        .PageSizes(true)
                        .ButtonCount(5))
                        .DataSource(dataSource => dataSource
                        .Ajax()
                        .Events(events => events.Error("error_handler"))
                        .Model(model =>
                        {
                            model.Id(x => x.JobAnnouncementId);
                        })
                        .Read(read => read.Action("Grid_Data_Read", "JobAnnouncement", new { Area = "Admin" })
                        .Data("getFilterDataParams"))
                        .PageSize(20)
                        )
                        )
        </div>
    </div>
    <div class="row" style="margin-top:20px;">
        <div class="col-xs-6 col-sm-6 col-md-6">
            <a href="@Url.Action("Create", "JobAnnouncement")" class="btn btn-success form-command-btn" style="display:inline-block;float:right;">
                <span><i class="fa fa-plus"></i><span>&nbsp;</span>ثبت جدید</span>
            </a>
        </div>
        <div class="col-xs-6 col-sm-6 col-md-6 text-left">
            @* <a href="@Url.Action("Index", "Dashboard")" class="btn btn-info form-command-btn" style="float:left;">
            <span class="btn-label"><i class="fa fa-reply"></i><span>&nbsp;</span>بازگشت</span>
            </a> *@
        </div>
    </div>
</div>

<script type="text/javascript">

    function editRow(e) {
        e.preventDefault();
        var dataItem = this.dataItem(jQuery(e.currentTarget).closest("tr"));
        window.location.href = "/Admin/JobAnnouncement/Edit/" + dataItem.JobAnnouncementId;
    }

    var getFilterDataParams = function (e) {
        var result = {
            filterTitle: $('#FilterTitle').val(),
            filterGender: $('#FilterGender').val(),
            filterPublishDateFrom: $('#FilterPublishDateFrom').val(),
            filterPublishDateTo: $('#FilterPublishDateTo').val(),
            filterCapacityFrom: $('#FilterCapacityFrom').val(),
            filterCapacityTo: $('#FilterCapacityTo').val(),
            filterHasEmploymentExam: $('#FilterHasEmploymentExam').val(),
            filterActive: $('#FilterActive').val(),
            filterExamDateFrom: $('#FilterExamDateFrom').val(),
            filterExamDateTo: $('#FilterExamDateTo').val(),
            filterInsertDateFrom: $('#FilterInsertDateFrom').val(),
            filterInsertDateTo: $('#FilterInsertDateTo').val()
        }
        return result;
    };

    function filterData() {
        $("#Grid").data("kendoGrid").dataSource.read();
    }

    function deleteRow(e) {
                e.preventDefault();
                var dataItem = this.dataItem(jQuery(e.currentTarget).closest("tr"));

                showConfirmModalMessage(
                    "danger",
                    "عملیات حذف",
                    "آیا از حذف اطمینان دارید؟",
                    "انصراف",
                    "حذف",
                    "danger",
                    "Confirm",
                    dataItem.JobAnnouncementId,
                    "Cancel",
                    null
                );
            }

            function Confirm(jobAnnouncementId) {
                $.ajax({
                    url: '/Admin/JobAnnouncement/Delete',
                    type: "GET",
                    data: {
                        id: jobAnnouncementId
                    }
                }).done(function (dresult) {
                    if (dresult == true) {
                        var reqGrid = $("#Grid").data("kendoGrid");
                        reqGrid.dataSource.read();
                        showSimpleModalMessage('success', 'عملیات انجام شد', 'اطلاعات موردنظر حذف شد', '');
                    }
                    else {
                        showSimpleModalMessage('danger', 'خطا', 'امکان حذف این اطلاعات وجود ندارد', '');
                    }
                }).fail(function (xhr) {
                    showSimpleModalMessage('danger', 'خطا', 'در ارسال درخواست خطا رخ داد: ' + (xhr.responseText || xhr.statusText), '');
                });
            }

            function Cancel(x) {

            }

    function interviewAppointmentListRow(e) {
        e.preventDefault();
        var dataItem = this.dataItem(jQuery(e.currentTarget).closest("tr"));
        window.location.href = "/Admin/InterviewAppointment/Index/" + dataItem.JobAnnouncementId;
    }

    function examListRow(e) {
        e.preventDefault();
        var dataItem = this.dataItem(jQuery(e.currentTarget).closest("tr"));
        window.location.href = "/Admin/JobAnnouncement_Exam_/Index/" + dataItem.JobAnnouncementId;
    }

    function showAnnouncementOperationMenu(e) {
         e.preventDefault();
         var dataItem = this.dataItem(jQuery(e.currentTarget).closest("tr"));

        openBottomDrawer("/Admin/JobAnnouncement/ShowOperationMenuDrawer/" + dataItem.JobAnnouncementId, 'عملیات آگهی شغلی', '45', 'عملیات آگهی شغلی', '#F4F8F9');
    }

</script>