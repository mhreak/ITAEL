@model Web.Model.JobAnnouncementViewModel

@{
    ViewData["PageTitle"] = "ویرایش آگهی";
}

<div style="margin-top:-14px;">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { name = "my-form", id = "my-form" }))
    {
        @Html.HiddenFor(model => model.JobAnnouncementId)
        @Html.HiddenFor(model => model.InsertDate)
        @Html.HiddenFor(model => model.IsDeleted)

        <div class="container-card padding30" style="padding-top:45px;">
            <div class="form-horizontal">
                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @Html.EditorFor(model => model.Title)
                        @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-7 col-sm-5">
                        <span style="color:red;font-size:20px;">*</span>
                    </div>
                </div>
                <div class="col-md-6 col-12">
                    <div class="row form-group" style="margin-top:30px;">
                        @Html.LabelFor(model => model.ProvinceName, htmlAttributes: new { @class = "control-label col-md-4 col-sm-12 col-12 form-input-label" })
                        <div class="col-md-6 col-sm-10 col-10">
                            @(Html.Kendo().DropDownList()
                                  .Name("ProvinceId")
                                  .OptionLabel("همه")
                                  .DataTextField("Text")
                                  .DataValueField("Value")
                                  .Value(Model.ProvinceId.ToString())
                                  .DataSource(source =>
                                              {
                                                  source.Read(read =>
                                                              {
                                                                  read.Action("Fill_Province_Combo", "Province", new { Area = "Admin" });
                                                              });
                                              })
                            )
                            @Html.ValidationMessageFor(model => model.ProvinceId, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-2 col-sm-2 col-2">
                            <span style="color:red;font-size:20px;">*</span>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6 col-12">
                    <div class="row form-group" style="margin-top:30px;">
                        @Html.LabelFor(model => model.CityName, htmlAttributes: new { @class = "control-label col-md-4 col-sm-12 col-12 form-input-label" })
                        <div class="col-md-6 col-sm-10 col-10">
                            @(Html.Kendo().DropDownList()
                                  .Name("CityId")
                                  .OptionLabel("همه")
                                  .DataTextField("Text")
                                  .DataValueField("Value")
                                  .Value(Model.CityId.ToString())
                                  .DataSource(source =>
                                              {
                                                  source.Read(read =>
                                                              {
                                                                  read.Action("Fill_City_Combo", "City", new { Area = "Admin" })
                                                                      .Data("filterCities");
                                                              })
                                                        .ServerFiltering(true);
                                              })
                                  .Enable(false)
                                  .AutoBind(false)
                                  .CascadeFrom("ProvinceId")
                            )
                            @Html.ValidationMessageFor(model => model.CityId, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-2 col-sm-2 col-2">
                            <span style="color:red;font-size:20px;">*</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-12">
                    <div class="row form-group" style="margin-top:30px;">
                        @Html.LabelFor(model => model.CompanyName, htmlAttributes: new { @class = "control-label col-md-4 col-sm-12 col-12 form-input-label" })
                        <div class="col-md-6 col-sm-10 col-10">
                            @(Html.Kendo().DropDownList()
                                  .Name("CompanyId")
                                  .OptionLabel("انتخاب کنید")
                                  .DataTextField("Text")
                                  .DataValueField("Value")
                                  .Value(Model.CompanyId.ToString())
                                  .DataSource(source =>
                                              {
                                                  source.Read(read =>
                                                              {
                                                                  read.Action("Fill_Company_Combo", "Company", new { Area = "Admin", active = "true" });
                                                              });
                                              })
                            )
                            @Html.ValidationMessageFor(model => model.CompanyId, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-2 col-sm-2 col-2">
                            <span style="color:red;font-size:20px;">*</span>
                        </div>
                    </div>
                </div>
                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.JobType, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @(Html.Kendo().DropDownList()
                              .Name("JobType")
                              .DataTextField("Text")
                              .DataValueField("Value")
                              .OptionLabel("حضوری  / غیرحضوری")
                              .HtmlAttributes(new { style = "width: 100%" })
                              .Value(Model.JobType.ToString())
                              .BindTo(new List<SelectListItem>() {
                                                                     new SelectListItem() {
                                                                                              Text = "حضوری",
                                                                                              Value = "1"
                                                                                          },
                                                                     new SelectListItem() {
                                                                                              Text = "غیرحضوری",
                                                                                              Value = "2"
                                                                                          }
                                                                 }))
                        @Html.ValidationMessageFor(model => model.JobType, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-7 col-sm-5">
                    </div>
                </div>
                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.JobTimeType, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @(Html.Kendo().DropDownList()
                              .Name("JobTimeType")
                              .DataTextField("Text")
                              .DataValueField("Value")
                              .OptionLabel("تمام‌وقت  / پاره‌وقت")
                              .HtmlAttributes(new { style = "width: 100%" })
                              .Value(Model.JobTimeType.ToString())
                              .BindTo(new List<SelectListItem>() {
                                                                     new SelectListItem() {
                                                                                              Text = "تمام‌وقت",
                                                                                              Value = "1"
                                                                                          },
                                                                     new SelectListItem() {
                                                                                              Text = "پاره‌وقت",
                                                                                              Value = "2"
                                                                                          }
                                                                 }))
                        @Html.ValidationMessageFor(model => model.JobTimeType, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-7 col-sm-5">
                    </div>
                </div>
                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.GenderStr, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @(Html.Kendo().DropDownList()
                              .Name("Gender")
                              .DataTextField("Text")
                              .DataValueField("Value")
                              .OptionLabel("همه")
                              .HtmlAttributes(new { style = "width: 100%" })
                              .Value(Model.Gender.ToString())
                              .BindTo(new List<SelectListItem>() {
                                                                     new SelectListItem() {
                                                                                              Text = "آقا",
                                                                                              Value = "True"
                                                                                          },
                                                                     new SelectListItem() {
                                                                                              Text = "خانم",
                                                                                              Value = "False"
                                                                                          }
                                                                 }))
                        @Html.ValidationMessageFor(model => model.Gender, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-7 col-sm-5">
                    </div>
                </div>

                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.Capacity, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @Html.EditorFor(model => model.Capacity, new { htmlAttributes = new { @type = "number", @min = "0", @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Capacity, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-7 col-sm-5">
                        <span style="color:red;font-size:20px;">*</span>
                    </div>
                </div>
                
                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.Price, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4" style="display: flex; align-items: center; gap: 5px;">
                        @Html.EditorFor(model => model.Price, new { htmlAttributes = new { @class = "form-control price-input", style = "flex:1;" } })
                        <span>تومان</span>
                    </div>
                    @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger" })
                </div>

                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.HasEmploymentExam, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @(Html.Kendo().DropDownList()
                              .Name("HasEmploymentExam")
                              .DataTextField("Text")
                              .DataValueField("Value")
                              .OptionLabel("همه")
                              .HtmlAttributes(new { style = "width: 100%" })
                              .Value(Model.HasEmploymentExam.ToString())
                              .BindTo(new List<SelectListItem>() {
                                                                     new SelectListItem() {
                                                                                              Text = "دارد",
                                                                                              Value = "True"
                                                                                          },
                                                                     new SelectListItem() {
                                                                                              Text = "ندارد",
                                                                                              Value = "False"
                                                                                          }
                                                                 }))
                        @Html.ValidationMessageFor(model => model.HasEmploymentExam, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-7 col-sm-5">
                        <span style="color:red;font-size:20px;">*</span>
                    </div>
                </div>
                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.ExamDate, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @Html.EditorFor(model => model.ExamDate)
                        @Html.ValidationMessageFor(model => model.ExamDate, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-7 col-sm-5">
                    </div>
                </div>
                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.PublishDate, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @Html.EditorFor(model => model.PublishDate)
                        @Html.ValidationMessageFor(model => model.PublishDate, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-7 col-sm-5">
                        <span style="color:red;font-size:20px;">*</span>
                    </div>
                </div>
                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.ExpirationDate, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @Html.EditorFor(model => model.ExpirationDate)
                        @Html.ValidationMessageFor(model => model.ExpirationDate, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-7 col-sm-5">
                    </div>
                </div>
                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.ShamsiJobAnnouncementApplicationDeadlineDateFrom, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @Html.EditorFor(model => model.JobAnnouncementApplicationDeadlineDateFrom)
                        @Html.ValidationMessageFor(model => model.JobAnnouncementApplicationDeadlineDateFrom, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-7 col-sm-5">
                    </div>
                </div>
                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.ShamsiJobAnnouncementApplicationDeadlineDateTo, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4">
                        @Html.EditorFor(model => model.JobAnnouncementApplicationDeadlineDateTo)
                        @Html.ValidationMessageFor(model => model.JobAnnouncementApplicationDeadlineDateTo, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-7 col-sm-5">
                    </div>
                </div>
                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.Salary, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4" style="display: flex; align-items: center; gap: 5px;">
                        @Html.EditorFor(model => model.Salary, new { htmlAttributes = new { @class = "form-control price-input", style = "flex:1;" } })
                        <span>تومان</span>
                    </div>
                    @Html.ValidationMessageFor(model => model.Salary, "", new { @class = "text-danger" })
                </div>
                <hr style="height:0.9px;" />
                <div class="row form-group" style="margin-top:30px;">
                    @Html.Label("دسته بندی ها", null, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 col-12 form-input-label" })
                    <div class="col-md-6 col-sm-4 col-12">
                        @(Html.Kendo().MultiSelect()
                            .Name("CategoryMultiSelect")
                            .Placeholder("لطفا دسته بندی های موردنظر را انتخاب نمائید")
                            .DownArrow(true)
                            .NoDataTemplateId("noDataTemplate")
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .Value((string[])ViewBag.JACategoryIdArray)
                            .Filter("contains")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("Fill_JobAnnouncementCategory_Combo", "JobAnnouncementCategory", new { Area = "Admin", active = "true" });
                                });
                            }))
                    </div>
                    <div class="col-md-4 col-sm-5">
                    </div>
                </div>
                <div class="row form-group" style="margin-top:30px;">
                    @Html.Label("مهارت های موردنیاز", null, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 col-12 form-input-label" })
                    <div class="col-md-6 col-sm-12 col-12">
                        @(Html.Kendo().MultiSelect()
                            .Name("SkillMultiSelect")
                            .Placeholder("لطفا مهارت های موردنظر را انتخاب نمائید")
                            .DownArrow(true)
                            .NoDataTemplateId("noDataTemplate")
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .Value((string[])ViewBag.SkillIdArray)
                            .Filter("contains")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("Fill_Skill_Combo", "Skill", new { Area = "Admin", active = "true" });
                                });
                            }))
                    </div>
                    <div class="col-md-4 col-sm-5">
                    </div>
                </div>
                <div class="row form-group" style="margin-top:30px;">
                    @Html.Label("رشته های تحصیلی", null, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 col-12 form-input-label" })
                    <div class="col-md-6 col-sm-12 col-12">
                        @(Html.Kendo().MultiSelect()
                              .Name("StudyFieldMultiSelect")
                              .Placeholder("لطفا رشته های تحصیلی موردنظر را انتخاب نمائید")
                              .DownArrow(true)
                              .NoDataTemplateId("noDataTemplate")
                              .DataTextField("Text")
                              .DataValueField("Value")
                              .Value((string[])ViewBag.StudyFieldIdArray)
                              .Filter("contains")
                              .DataSource(source =>
                                          {
                                              source.Read(read =>
                                                          {
                                                              read.Action("Fill_StudyField_Combo", "StudyField", new { Area = "Admin", active = "true" });
                                                          });
                                          }))
                    </div>
                    <div class="col-md-4 col-sm-5">
                    </div>
                </div>
                <hr style="height:0.9px;" />
                <div class="row form-group" style="margin-top:30px;">
                    @Html.Label(null, "نمایش اطلاعات شرکت", htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 col-12 form-input-label" })
                    <div class="col-md-3 col-sm-4" style="padding-right:6px;">
                        <input type="checkbox" asp-for="@Model.ShowCompanyInfo" checked data-switch="success" />
                        <label for="ShowCompanyInfo" data-on-label="بله" data-off-label="خیر" style="margin-right:8px;"></label>
                    </div>
                </div>
                <div class="row form-group" style="margin-top:30px;">
                    @Html.Label(null, "فعال", htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-3 col-sm-4" style="padding-right:6px;">
                        <input type="checkbox" asp-for="@Model.Active" checked data-switch="success" />
                        <label for="Active" data-on-label="بله" data-off-label="خیر" style="margin-right:8px;"></label>
                    </div>
                </div>
                <div class="row form-group" style="margin-top:30px;">
                    @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-2 col-sm-3 form-input-label" })
                    <div class="col-md-8 col-sm-12 col-12">
                        <div class="col-12 k-rtl" style="margin-top:22px;">
                            @(Html.Kendo().EditorFor(model => model.Description)
                                  .HtmlAttributes(new { style = "width: 100%; height:360px;font-family:'IranSans';", aria_label = "editor" })
                                  .Encoded(false)
                                  .Tools(tools => tools
                                                  .Clear()
                                                  .Bold().Italic().Underline()
                                                  .JustifyLeft().JustifyCenter().JustifyRight().JustifyFull()
                                                  .InsertOrderedList()
                                                  .InsertUnorderedList()
                                                  .Outdent().Indent()
                                                  .CreateLink().Unlink()
                                                  .FontSize()
                                  )
                            )
                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-7 col-sm-5">
                    </div>
                </div>
                <hr style="margin-top:45px;color:orangered;" />
                <div class="row" style="margin-top:12px;">
                    <div class="col-md-6 col-sm-12">
                        <input type="submit" class="btn btn-success form-command-btn" value="ذخیره" style="float:right;" />
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <a href=@Url.Action("Index", "JobAnnouncement", new { Area = "Admin" }) class="btn btn-danger form-command-btn" style="float: left;">بازگشت</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script>

        function filterCities() {
            return {
                provinceId: $("#ProvinceId").val(),
                active: null
            };
        }

$(document).on("input", ".price-input", function () {
        let value = $(this).val();

        value = value.replace(/[^0-9.]/g, "");

        let parts = value.split(".");
        if (parts.length > 2) {
            value = parts[0] + "." + parts[1];
        }

        let integer = parts[0].replace(/,/g, "");
        let decimal = parts.length > 1 ? "." + parts[1] : "";

        if (integer) {
            integer = Number(integer).toLocaleString();
        }

        $(this).val(integer + decimal);
    });
</script>
