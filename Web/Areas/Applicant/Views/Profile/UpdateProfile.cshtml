@model UpdateProfileViewModel


<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ویرایش اطلاعات</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@majidh1/jalalidatepicker/dist/jalalidatepicker.min.css" />
    <link rel="stylesheet" href="~/css/style/styles.css">

</head>


<div class="col-lg-8 order-2">
    <div class="card profile-edit-card h-100">
        <div class="edit-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="edit-title mb-1">ویرایش اطلاعات</h5>
                <small class="text-body-secondary">لطفا اطلاعات خود را تکمیل یا اصلاح کنید</small>
            </div>

            <span class="edit-badge">
                <label class="bi bi-person-check ms-1">کاربر فعال</label>
            </span>
        </div>

        <div class="card-body pt-3">
            <form asp-area="Applicant" asp-controller="Profile" asp-action="UpdateProfile" method="post" id="profile-form" class="edit-form" enctype="multipart/form-data">
                <input asp-for="ApplicantViewModel.ApplicantId" type="hidden" />
                @Html.AntiForgeryToken()
                <div class="row g-3 g-md-4">
                    <div class="col-md-6">
                        <label asp-for="ApplicantViewModel.FirstName" class="form-label small mb-1">
                            نام
                            <span class="text-danger">*</span>
                        </label>
                        <input asp-for="ApplicantViewModel.FirstName" value="@Model.ApplicantViewModel.FirstName" type="text" id="full_name" data-required="true" data-only-text="true" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ApplicantViewModel.LastName" class="form-label small mb-1">
                            نام خانوادگی
                            <span class="text-danger">*</span>
                        </label>
                        <input asp-for="ApplicantViewModel.LastName" value="@Model.ApplicantViewModel.LastName" type="text" id="full_name" data-required="true" data-only-text="true" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ApplicantViewModel.NationalCode" class="form-label small mb-1">
                            کد ملی
                            <span class="text-danger">*</span>
                        </label>
                        <input asp-for="ApplicantViewModel.NationalCode" value="@Model.ApplicantViewModel.NationalCode" type="text" id="national_id" data-required="true" inputmode="numeric" maxlength="10" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ApplicantViewModel.Gender" class="form-label small mb-1">
                            جنسیت
                            <span class="text-danger">*</span>
                        </label>
                        <select asp-for="ApplicantViewModel.Gender" id="sex" class="form-select" data-required="true">
                            <option value="" disabled selected>انتخاب کنید</option>
                            <option value="true">آقا</option>
                            <option value="false">خانم</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ApplicantViewModel.Phone" class="form-label small mb-1">تلفن ثابت</label>
                        <input asp-for="ApplicantViewModel.Phone" value="@Model.ApplicantViewModel.Phone" type="text" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ApplicantViewModel.Mobile" class="form-label small mb-1">
                            تلفن همراه
                            <span class="text-danger">*</span>
                        </label>
                        <input asp-for="ApplicantViewModel.Mobile" value="@Model.ApplicantViewModel.Mobile" type="text" id="mobile" data-required="true" inputmode="numeric" maxlength="11" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ApplicantViewModel.BirthDate" class="form-label small mb-1">
                            تاریخ تولد
                            <span class="text-danger">*</span>
                        </label>
                        <div class="position-relative">
                            <input asp-for="ApplicantViewModel.BirthDate" value="@Model.ApplicantViewModel.ShamsiBirthDate" type="text" class="form-control" id="birthdate" data-jdp>
                            <button type="button" class="btn position-absolute top-50 start-0 translate-middle-y border-0 bg-transparent calendar-btn px-2">
                                <i class="bi bi-calendar-event text-primary fs-5"></i>
                            </button>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ApplicantViewModel.StudyFieldId" class="form-label small mb-1">
                            رشته تحصیلی
                            <span class="text-danger">*</span>
                        </label>
                        <select asp-for="ApplicantViewModel.StudyFieldId" id="StudyFieldMultiSelect" class="form-select" data-required="true"></select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ApplicantViewModel.ProvinceId" class="form-label small mb-1">
                            استان
                            <span class="text-danger">*</span>
                        </label>
                        <select asp-for="ApplicantViewModel.ProvinceId" id="ProvinceMultiSelect" class="form-select" data-required="true"></select>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="ApplicantViewModel.CityId" class="form-label small mb-1">
                            شهر
                            <span class="text-danger">*</span>
                        </label>
                        <select asp-for="ApplicantViewModel.CityId" id="CityMultiSelect" class="form-select" data-required="true">
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ApplicantViewModel.EnglishLanguageLevel" class="form-label small mb-1">سطح زبان انگلیسی</label>
                        <select asp-for="ApplicantViewModel.EnglishLanguageLevel" class="form-select">
                            <option value="" disabled selected>انتخاب کنید</option>
                            <option value="1">عالی</option>
                            <option value="2">متوسط</option>
                            <option value="3">ضعیف</option>
                        </select>
                    </div>
                </div>

                <hr class="my-4">

                <div class="row g-3 mt-4">
                    <div class="col-md-6">
                        <div class="upload-header">
                            <span class="upload-title">اسکن مدرک تحصیلی</span>
                        </div>
                        <div class="upload-card">
                            <div class="upload-body d-flex align-items-center justify-content-between gap-2">

                                <div>
                                    <span class="upload-text">هیچ فایلی انتخاب نشده</span>
                                    <label class="upload-btn">
                                        انتخاب فایل
                                        <input type="file" class="upload-input" name="EducationalCertificateFile" />
                                    </label>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.EducationalCertificateFileUrl))
                                {
                                    <a href="@Model.EducationalCertificateFileUrl"
                                       target="_blank"
                                       download
                                       class="text-success fs-4"
                                       title="دانلود فایل">
                                        <i class="bi bi-download"></i>
                                    </a>
                                }

                            </div>
                        </div>


                        <div class="upload-header">
                            <span class="upload-title">اسکن کارت ملی (رو)</span>
                        </div>
                        <div class="upload-card">
                            
                            <div class="upload-body d-flex align-items-center justify-content-between gap-2">

                                <div>
                                    <span class="upload-text">هیچ فایلی انتخاب نشده</span>
                                    <label class="upload-btn">
                                        انتخاب فایل
                                        <input type="file" class="upload-input" name="NationalCardFrontFile" />
                                    </label>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.NationalCardFrontFileUrl))
                                {
                                    <a href="@Model.NationalCardFrontFileUrl"
                                       target="_blank"
                                       download
                                       class="text-success fs-4"
                                       title="دانلود فایل">
                                        <i class="bi bi-download"></i>
                                    </a>
                                }

                            </div>

                        </div>

                        <div class="upload-header">
                            <span class="upload-title">شناسنامه (صفحه اول)</span>
                        </div>
                        <div class="upload-card">
                            
                            <div class="upload-body d-flex align-items-center justify-content-between gap-2">

                                <div>
                                    <span class="upload-text">هیچ فایلی انتخاب نشده</span>
                                    <label class="upload-btn">
                                        انتخاب فایل
                                        <input type="file" class="upload-input" name="IdentityCertificateFirstPageFile" />
                                    </label>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.IdentityCertificateFirstPageFileUrl))
                                {
                                    <a href="@Model.IdentityCertificateFirstPageFileUrl"
                                       target="_blank"
                                       download
                                       class="text-success fs-4"
                                       title="دانلود فایل">
                                        <i class="bi bi-download"></i>
                                    </a>
                                }

                            </div>

                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="upload-header">
                            <span class="upload-title">عکس پرسنلی</span>
                        </div>
                        <div class="upload-card">
                            
                            <div class="upload-body d-flex align-items-center justify-content-between gap-2">

                                <div>
                                    <span class="upload-text">هیچ فایلی انتخاب نشده</span>
                                    <label class="upload-btn">
                                        انتخاب فایل
                                        <input type="file" class="upload-input" name="PersonalImageFile" />
                                    </label>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.PersonalImageFileUrl))
                                {
                                    <a href="@Model.PersonalImageFileUrl"
                                       target="_blank"
                                       download
                                       class="text-success fs-4"
                                       title="دانلود فایل">
                                        <i class="bi bi-download"></i>
                                    </a>
                                }

                            </div>

                        </div>

                        <div class="upload-header">
                            <span class="upload-title">اسکن کارت ملی (پشت)</span>
                        </div>
                        <div class="upload-card">
                            
                            <div class="upload-body d-flex align-items-center justify-content-between gap-2">

                                <div>
                                    <span class="upload-text">هیچ فایلی انتخاب نشده</span>
                                    <label class="upload-btn">
                                        انتخاب فایل
                                        <input type="file" class="upload-input" name="NationalCardBackFile" />
                                    </label>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.NationalCardBackFileUrl))
                                {
                                    <a href="@Model.NationalCardBackFileUrl"
                                       target="_blank"
                                       download
                                       class="text-success fs-4"
                                       title="دانلود فایل">
                                        <i class="bi bi-download"></i>
                                    </a>
                                }

                            </div>

                        </div>

                        <div class="upload-header">
                            <span class="upload-title">شناسنامه (صفحه دوم)</span>
                        </div>
                        <div class="upload-card">
                            
                            <div class="upload-body d-flex align-items-center justify-content-between gap-2">

                                <div>
                                    <span class="upload-text">هیچ فایلی انتخاب نشده</span>
                                    <label class="upload-btn">
                                        انتخاب فایل
                                        <input type="file" class="upload-input" name="IdentityCertificateSecondPageFile" />
                                    </label>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.IdentityCertificateSecondPageFileUrl))
                                {
                                    <a href="@Model.IdentityCertificateSecondPageFileUrl"
                                       target="_blank"
                                       download
                                       class="text-success fs-4"
                                       title="دانلود فایل">
                                        <i class="bi bi-download"></i>
                                    </a>
                                }

                            </div>

                        </div>
                    </div>
                </div>
                <br>
                <div class="d-flex justify-content-between justify-content-md-end gap-2 mt-4">
                    <a asp-area="Applicant" asp-controller="Dashboard" asp-action="Index" type="button" class="btn btn-outline-secondary px-3">
                        بازگشت
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        ذخیره تغییرات
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/@@majidh1/jalalidatepicker/dist/jalalidatepicker.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>

    if (window.jalaliDatepicker && typeof jalaliDatepicker.startWatch === "function") {
        jalaliDatepicker.startWatch();
    }

    $(function () {
        if ($.fn.persianDatepicker) {
            $("#birthdate").persianDatepicker({
                format: "YYYY/MM/DD",
                autoClose: true,
                initialValue: false,
                toolbox: { calendarSwitch: { enabled: false } }
            });
        } else {
            console.warn("persianDatepicker is not loaded.");
        }


        function loadOptions(url, elementId) {
            $.getJSON(url)
                .done(function (data) {
                    var options = '';
                    data.forEach(function (item) {
                        options += '<option value="' + item.Value + '">' + item.Text + '</option>';
                    });
                    var $el = $('#' + elementId);
                    $el.html(options);

                    if ($.fn.selectpicker) {
                        $el.selectpicker('refresh');
                    }
                })
                .fail(function (jqXHR, textStatus, err) {
                    console.error("Error loading options for " + elementId + ": " + textStatus, err);
                });
        }

                var studyFieldUrl = '@Url.Action("Fill_StudyField_Combo", "StudyField", new { area = "Applicant", active = true })';
    $.getJSON(studyFieldUrl, function (data) {
        var options = '';
        data.forEach(function (item) {
            options += '<option value="' + item.Value + '"'
                     + (item.Value == '@Model.ApplicantViewModel.StudyFieldId' ? ' selected' : '')
                     + '>' + item.Text + '</option>';
        });
        var $el = $('#StudyFieldMultiSelect');
        $el.html(options);
        if ($.fn.selectpicker) $el.selectpicker('refresh');
    });


        var provinceUrl = '@Url.Action("Fill_Province_Combo", "Province", new { area = "Applicant" })';
        $.getJSON(provinceUrl, function (data) {
            var options = '';
            data.forEach(function (item) {
                options += '<option value="' + item.Value + '"'
                         + (item.Value == '@Model.ApplicantViewModel.ProvinceId' ? ' selected' : '')
                         + '>' + item.Text + '</option>';
            });
            var $province = $('#ProvinceMultiSelect');
            $province.html(options);
            if ($.fn.selectpicker) $province.selectpicker('refresh');


            var provinceId = $province.val();
            if (provinceId) {
                loadCities(provinceId);
            }
        });

        function loadCities(provinceId) {
            var cityUrl = '@Url.Action("Fill_City_Combo", "City", new { area = "Applicant" })' + '?provinceId=' + provinceId;
            $.getJSON(cityUrl, function (data) {
                var options = '';
                data.forEach(function (item) {
                    options += '<option value="' + item.Value + '"'
                             + (item.Value == '@Model.ApplicantViewModel.CityId' ? ' selected' : '')
                             + '>' + item.Text + '</option>';
                });
                var $city = $('#CityMultiSelect');
                $city.html(options);
                if ($.fn.selectpicker) $city.selectpicker('refresh');
            });
        }

        $('#ProvinceMultiSelect').on('change', function () {
            var provinceId = $(this).val();
            if (!provinceId) return;
            loadCities(provinceId);
        });
    });

</script>
</html>
