@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Web.Areas.Applicant.Controllers.ChangePasswordViewModel
@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>صفحه تغییر رمزعبور کاریابی من</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://cdn.fontcdn.ir/Font/Persian/IranSansX/IranSansX.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style/styles1.css" />
</head>
<body class="bg-app">
@* ---------- Global Alerts (Error + Success) ---------- *@
<div class="container mt-3">
    @* 1) TempData Error (برای Redirect ها) *@
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show global-alert" role="alert" aria-live="assertive" aria-atomic="true">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
        </div>
    }

    @* 2) Model-level errors (AddModelError("", "...")) *@
    @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert alert-danger alert-dismissible fade show global-alert" role="alert" aria-live="assertive" aria-atomic="true">
            @foreach (var err in ViewData.ModelState[string.Empty].Errors)
            {
                <div>@err.ErrorMessage</div>
            }
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
        </div>
    }

    @* 3) TempData Success (برای پیام‌های موفقیت بعد از Redirect) *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show global-alert" role="alert" aria-live="polite" aria-atomic="true">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
        </div>
    }
</div>
@* ---------- End Global Alerts ---------- *@   
<main class="min-vh-100 d-flex align-items-center justify-content-center px-3">
    <div class="auth-card w-100" style="max-width:520px;">
        <header class="mb-3 text-center">
            <img src="~/image/forgot.png" class="page-icon" alt="تغییر رمز عبور">
            <h1 class="h3 fw-bold text-ink mb-2">تغییر رمز عبور</h1>
            <p class="text-muted-ink mb-0">برای تغییر رمز عبور خود، اطلاعات زیر را وارد کنید.</p>
        </header>

        <form asp-area="Applicant" asp-controller="Account" asp-action="ChangePassword" method="post" class="needs-validation" autocomplete="off" novalidate>
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label">رمزعبورفعلی</label>
                <input asp-for="CurrentPassword" type="password" class="form-control" min="5" autocomplete="off" required>
                <span style="color:red" asp-validation-for="CurrentPassword"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">رمزعبور جدید</label>
                <input asp-for="NewPassword" type="password" class="form-control" min="5" autocomplete="off" required>
                <span style="color:red" asp-validation-for="NewPassword"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmNewPassword" class="form-label">تائید رمزعبور جدید</label>
                <input asp-for="ConfirmNewPassword" type="password" class="form-control" min="5" autocomplete="off" required>
                <span style="color:red" asp-validation-for="ConfirmNewPassword"></span>
            </div>


            <button class="btn btn-brand w-100 btn-lg mb-3" type="submit">تغییر رمزعبور</button>

            <hr class="hr-form">
            <p class="text-center mt-3 mb-0 text-muted-ink">
                <a class="link-accent" asp-area="Applicant" asp-controller="Dashboard" asp-action="Index">بازگشت به داشبورد اصلی</a>
            </p>
        </form>
    </div>
</main>



<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
        // ولیدیشن Bootstrap
        (() => {
          'use strict';
          const forms = document.querySelectorAll('.needs-validation');
          Array.from(forms).forEach(form => {
            form.addEventListener('submit', event => {
              if (!form.checkValidity()) { event.preventDefault(); event.stopPropagation(); }
              form.classList.add('was-validated');
            }, false);
          });
        })();

    </script>
<script>
        // Auto dismiss alerts after 5 seconds, و اسکرول به اولین alert
        document.addEventListener("DOMContentLoaded", function () {
            const alerts = document.querySelectorAll(".global-alert");
            if (alerts.length > 0) {
                // Scroll to first alert (smooth)
                alerts[0].scrollIntoView({ behavior: "smooth", block: "center" });

                // Auto hide after 5s (5000ms)
                setTimeout(() => {
                    alerts.forEach(a => {
                        // Bootstrap alert disposal: trigger close by removing 'show' (fade will hide)
                        a.classList.remove("show");
                        // fully remove from DOM after animation (300ms)
                        setTimeout(() => a.remove(), 350);
                    });
                }, 5000);
            }

            // optional: close button already handled by bootstrap data-bs-dismiss
        });
    </script>
</body>
</html>