@model Web.Controllers.JobAnnouncementDetailsViewModel

<title>جزئیات آگهی | ایتائل</title>

<main class="job-detail-layout">
    <section class="job-detail-hero">
        <div class="container">
            <div class="job-detail-hero-inner">
                <span class="job-detail-badge">فرصت شغلی فعال</span>
                <h1 class="job-detail-title mb-2">@Model.JobAnnouncementViewModel.Title</h1>
                <div class="job-detail-meta">
                    @if (!string.IsNullOrEmpty(Model.JobAnnouncementViewModel.CompanyName))
                    {
                        <span><i class="bi bi-building"></i> @Model.JobAnnouncementViewModel.CompanyName</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.JobAnnouncementViewModel.CityName))
                    {
                        <span><i class="bi bi-geo-alt"></i> @Model.JobAnnouncementViewModel.ProvinceName، @Model.JobAnnouncementViewModel.CityName</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.JobAnnouncementViewModel.JobTimeTypeStr))
                    {
                        <span><i class="bi bi-clock"></i> @Model.JobAnnouncementViewModel.JobTimeTypeStr</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.JobAnnouncementViewModel.JobTypeStr))
                    {
                        <span><i class="bi bi-laptop"></i> @Model.JobAnnouncementViewModel.JobTypeStr</span>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="job-detail-section py-5">
        <div class="container">

            <div class="row g-4">
                <div class="col-lg-8">

                    <article class="job-detail-card card mb-4">
                        <div class="card-body d-flex flex-column flex-md-row align-items-start gap-3">
                            @if (!string.IsNullOrEmpty(Model.JobAnnouncementViewModel.CompanyLogoFileName))
                            {
                                <div class="job-card-logo">
                                    <img src="~/Upload/CompanyDocument/@Model.JobAnnouncementViewModel.CompanyId/@Model.JobAnnouncementViewModel.CompanyLogoFileName" alt="@Model.JobAnnouncementViewModel.CompanyName">
                                </div>
                            }
                            else
                            {
                                <div class="job-card-logo">
                                    <img src="~/image/ITAEL-logo.png" alt="@Model.JobAnnouncementViewModel.CompanyName">
                                </div>
                            }
                            <div class="flex-grow-1">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                    <h2 class="job-detail-heading mb-0">@Model.JobAnnouncementViewModel.Title</h2>
                                </div>
                                <div class="job-card-meta small mt-1">
                                    @if (!string.IsNullOrEmpty(Model.JobAnnouncementViewModel.ShamsiJobAnnouncementApplicationDeadlineDateTo))
                                    {
                                        <span>
                                            <i class="bi bi-calendar-event ms-1"></i>مهلت ارسال درخواست: @Model.JobAnnouncementViewModel.ShamsiJobAnnouncementApplicationDeadlineDateTo
                                        </span>
                                    }
                                    @if (Model.JobAnnouncementViewModel.Salary is null or 0)
                                    {
                                        <span class="ms-3">
                                            <i class="bi bi-cash-coin ms-1"></i>حقوق توافقی
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="ms-3">
                                            <i class="bi bi-cash-coin ms-1"></i>
                                            @String.Format("{0:#,0}", Model.JobAnnouncementViewModel.Salary) تومان
                                        </span>
                                    }
                                    @if (Model.JobAnnouncementJobAnnouncementCategoryViewModelList is { Count: > 0 })
                                    {
                                        <span class="ms-3">
                                            <i class="bi bi-person-workspace ms-1"></i>
                                            @string.Join(", ", Model.JobAnnouncementJobAnnouncementCategoryViewModelList.Select(x => x.JobAnnouncementCategoryName))
                                        </span>
                                    }

                                </div>
                                
                                @if (!string.IsNullOrEmpty(Model.JobAnnouncementViewModel.JobTimeTypeStr))
                                {
                                    <span class="job-badge-type">@Model.JobAnnouncementViewModel.JobTimeTypeStr</span>
                                }
                                @if (!string.IsNullOrEmpty(Model.JobAnnouncementViewModel.JobTypeStr))
                                {
                                    <span class="job-badge-mode">@Model.JobAnnouncementViewModel.JobTypeStr</span>
                                }

                            </div>
                        </div>
                    </article>

                    <article class="job-detail-card card mb-4">
                        <div class="card-body job-detail-content">

                            @Html.Raw(Model.JobAnnouncementViewModel.Description)
                            
                            @if (Model.JobAnnouncementSkillViewModelList is { Count: > 0 })
                            {
                                <h3>مهارت ها</h3>
                                <div class="job-detail-skills mt-3">
                                    @foreach (var jobAnnouncementSkillViewModel in Model.JobAnnouncementSkillViewModelList)
                                    {
                                        <span class="skill-badge">@jobAnnouncementSkillViewModel.SkillName</span>
                                    }
                                </div>
                            }
                            

                            @if (Model.JobAnnouncementStudyFieldViewModelList is { Count: > 0 })
                            {
                                <h3>رشته های تحصیلی</h3>
                                <div class="job-detail-study mt-3">
                                    @foreach (var jobAnnouncementStudyFieldViewModel in Model.JobAnnouncementStudyFieldViewModelList)
                                    {
                                        <span class="study-badge">@jobAnnouncementStudyFieldViewModel.StudyFieldName</span>
                                    }
                                </div>
                            }
                            

                            <div class="text-start mt-4">
                                @if (@Model.IsAllowToSubmitRequest)
                                {
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <form asp-area="" asp-controller="JobAnnouncement" asp-action="SubmitRequest" method="post">
                                            <input type="hidden" name="id" value="@Model.JobAnnouncementViewModel.JobAnnouncementId" />
                                            <button type="submit" class="btn btn-primary w-100">
                                                درخواست
                                            </button>
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
                                        </form>

                                    }
                                    else
                                    {
                                        <a asp-area="Applicant" asp-controller="Account" asp-action="Login" type="submit" class="btn btn-primary w-100">
                                            درخواست
                                        </a>
                                    }

                                }
                                else
                                {
                                    <button class="btn btn-outline-primary w-100 disabled">
                                        مهلت ارسال درخواست برای آگهی به پایان رسیده است.
                                    </button>
                                }
                            </div>
                        </div>
                    </article>

                </div>

                <!-- Sidebar -->
                <div class="col-lg-4 job-summary-col">

                    <div class="job-summary-card card mb-3">
                        <div class="card-body">
                            <h5 class="job-summary-title mb-3">خلاصه موقعیت شغلی</h5>
                            <ul class="list-unstyled job-summary-list mb-0">
                                <li>
                                    <span class="label">نوع همکاری</span>
                                    <span class="value">@Model.JobAnnouncementViewModel.JobTimeTypeStr</span>
                                </li>
                                <li>
                                    <span class="label">شیوه کار</span>
                                    <span class="value">@Model.JobAnnouncementViewModel.JobTypeStr</span>
                                </li>
                                <li>
                                    <span class="label">موقعیت مکانی</span>
                                    <span class="value">@Model.JobAnnouncementViewModel.ProvinceName، @Model.JobAnnouncementViewModel.CityName</span>
                                </li>
                                <li>
                                    <span class="label">تاریخ انتشار</span>
                                    <span class="value">@Model.JobAnnouncementViewModel.ShamsiPublishDate</span>
                                </li>

                                @if (!string.IsNullOrEmpty(Model.JobAnnouncementViewModel.ShamsiJobAnnouncementApplicationDeadlineDateTo))
                                {
                                    <li>
                                        <span class="label">مهلت ارسال درخواست</span>
                                        <span class="value text-danger">@Model.JobAnnouncementViewModel.ShamsiJobAnnouncementApplicationDeadlineDateTo</span>
                                    </li>
                                }

                            </ul>
                        </div>
                    </div>

                    @if (Model.JobAnnouncementViewModel.ShowCompanyInfo)
                    {
                        @if (!string.IsNullOrEmpty(Model.CompanyViewModel.Description))
                        {
                            <div class="job-summary-card card mb-3">
                                <div class="card-body">

                                    <h5 class="job-summary-title mb-3">درباره شرکت</h5>
                                    <p class="small text-muted">
                                        @Html.Raw(Model.CompanyViewModel.Description)
                                    </p>

                                    <ul class="list-unstyled small mb-0">

                                        @if (!string.IsNullOrEmpty(Model.JobAnnouncementViewModel.CityName))
                                        {
                                            <li class="mb-1">
                                                <i class="bi bi-geo-alt ms-1"></i> @Model.JobAnnouncementViewModel.ProvinceName، @Model.JobAnnouncementViewModel.CityName
                                            </li>
                                        }

                                        @if (!string.IsNullOrEmpty(Model.CompanyViewModel.WebsiteAddress))
                                        {
                                            <li class="mb-1">
                                                <i class="bi bi-globe2 ms-1"></i>
                                                <a href="#" class="link-primary text-decoration-none">@Model.CompanyViewModel.WebsiteAddress</a>
                                            </li>
                                        }

                                    </ul>


                                </div>
                            </div>
                        }
                    }

                    <div class="job-summary-card card">
                        <div class="card-body text-center">
                            <h6 class="mb-2">این موقعیت برای شما مناسب است؟</h6>
                            <p class="small text-muted mb-3">
                                اگر خودتان را مناسب این شغل می‌دانید، همین حالا درخواست‌تان را ثبت کنید.
                            </p>
                            @if (@Model.IsAllowToSubmitRequest)
                            {
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <form asp-area="" asp-controller="JobAnnouncement" asp-action="SubmitRequest" method="post">
                                        <input type="hidden" name="id" value="@Model.JobAnnouncementViewModel.JobAnnouncementId" />
                                        <button type="submit" class="btn btn-primary w-100">
                                            درخواست
                                        </button>
                                    </form>

                                }
                                else
                                {
                                    <a asp-area="Applicant" asp-controller="Account" asp-action="Login" type="submit" class="btn btn-primary w-100">
                                        درخواست
                                    </a>
                                }

                            }
                            else
                            {
                                <button class="btn btn-outline-primary w-100 disabled">
                                    مهلت ارسال درخواست برای آگهی به پایان رسیده است.
                                </button>
                            }

                        </div>
                    </div>

                </div>

            </div>

        </div>
    </section>
</main>

<script>
    const href = window.location.href;
    if (href.includes("job-detail")) {
        document.getElementById("nav-home")?.classList.add("active");
    }
</script>