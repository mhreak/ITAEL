@model AboutUsSettingViewModel

<head>
    <title>درباره ما | ایتائل</title>
    <link rel="stylesheet" href="~/css/style/about.css">
</head>
<body class="bg-body">
    <main class="about-layout">
        <section class="about-hero">
            <div class="container">
                <div class="about-hero-inner">
                    @* <span class="about-detail-badge">بیش از 200 آگهی</span> *@
                    <h1 class="about-detail-title mb-2">درباره ما</h1>
                </div>
            </div>
        </section>

        <section class="container my-4">
            <div class="card-body about-content">
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <article class="about-card card mb-4">
                        @Html.Raw(Model.Description)
                    </article>
                }

            </div>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const href = window.location.href;
        if (href.includes("job-detail")) {
            document.getElementById("nav-home")?.classList.add("active");
        }
    </script>
</body>
