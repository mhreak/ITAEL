@model Web.Model.JobAnnouncementViewModel
@{
    ViewData["Title"] = "آگهی های شغلی";
    Layout = "_Layout";
}
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>آگهی های شغلی</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.1/css/bootstrap-select.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.1/js/bootstrap-select.min.js"></script>
</head>
<body>
    <div class="container-fluid mt-4">
        <h2 class="mb-4">آگهی های شغلی</h2>
        <div class="row mb-3">
            <div class="col-md-2">
                <label for="filterJobType">نوع شغل</label>
                <select id="filterJobType" class="form-control">
                    <option value="">همه</option>
                    <option value="1">حضوری</option>
                    <option value="2">دورکاری</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="filterJobTime">نوع ساعت کاری</label>
                <select id="filterJobTime" class="form-control">
                    <option value="">همه</option>
                    <option value="1">تمام‌وقت</option>
                    <option value="2">پاره‌وقت</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="CategoryMultiSelect">دسته‌بندی</label>
                <select id="CategoryMultiSelect" class="form-control selectpicker" multiple data-live-search="true"></select>
            </div>
            <div class="col-md-2">
                <label for="StudyFieldMultiSelect">رشته تحصیلی</label>
                <select id="StudyFieldMultiSelect" class="form-control selectpicker" multiple data-live-search="true"></select>
            </div>
            <div class="col-md-2">
                <label for="SkillMultiSelect">مهارت</label>
                <select id="SkillMultiSelect" class="form-control selectpicker" multiple data-live-search="true"></select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button id="filterBtn" class="btn btn-primary w-100">
                    <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    فیلتر
                </button>
            </div>
        </div>
        <div id="announcementCardBody" class="row"></div>
        <div id="loadingSpinner" class="text-center mt-3 d-none">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">در حال بارگذاری...</span>
            </div>
        </div>
    </div>

    <!-- Error Modal -->
    <div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger" id="errorModalLabel">خطا</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    خطایی در دریافت داده‌ها رخ داد. لطفاً دوباره تلاش کنید.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $('.selectpicker').selectpicker();

            function loadOptions(url, elementId) {
                $.get(url)
                    .done(function (data) {
                        let options = '';
                        data.forEach(item => {
                            options += `<option value="${item.Value}">${item.Text}</option>`;
                        });
                        $(`#${elementId}`).html(options).selectpicker('refresh');
                    })
                    .fail(function () {
                        console.error(`Error loading options for ${elementId}`);
                    });
            }

            loadOptions('/JobAnnouncementCategory/Fill_JobAnnouncementCategory_Combo?active=true', 'CategoryMultiSelect');
            loadOptions('/StudyField/Fill_StudyField_Combo?active=true', 'StudyFieldMultiSelect');
            loadOptions('/Skill/Fill_Skill_Combo?active=true', 'SkillMultiSelect');

            $('#filterBtn').on('click', function () {
                const filters = {
                    filterJobType: $('#filterJobType').val(),
                    filterJobTime: $('#filterJobTime').val(),
                    filterCategoryId: $('#CategoryMultiSelect').val() ? $('#CategoryMultiSelect').val().join(',') : '',
                    filterStudyFieldId: $('#StudyFieldMultiSelect').val() ? $('#StudyFieldMultiSelect').val().join(',') : '',
                    filterSkillId: $('#SkillMultiSelect').val() ? $('#SkillMultiSelect').val().join(',') : ''
                };

                console.log(filters);
                loadAnnouncements(filters);
            });

            function loadAnnouncements(filters = {}) {
                $("#loadingSpinner").removeClass("d-none");
                $("#filterBtn").prop("disabled", true).find(".spinner-border").removeClass("d-none");

                fetch(`/GetAnnouncements?${new URLSearchParams(filters)}`)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error("پاسخ شبکه درست نبود");
                        }
                        return response.json();
                    })
                    .then(data => {
                        $("#announcementCardBody").html("");

                        if (data.length > 0) {
                            data.forEach(job => {
                                const card = `
                                    <div class="col-12">
                                        <div class="card mb-4">
                                            <div class="card-body">
                                                <h5 class="card-title">${job.Title}</h5>
                                                <h6 class="card-subtitle mb-2 text-muted">${job.CompanyName}</h6>
                                                <p><strong>تاریخ انتشار:</strong> ${job.ShamsiPublishDate}</p>
                                                <p><strong>نوع شغل:</strong> ${job.JobTypeStr}</p>
                                                <p><strong>نوع ساعت کاری:</strong> ${job.JobTimeTypeStr}</p>
                                                <p><strong>ظرفیت:</strong> ${job.Capacity}</p>
                                                <p><strong>جنسیت:</strong> ${job.GenderStr}</p>
                                                <a href="#" class="btn btn-primary">مشاهده جزئیات</a>
                                            </div>
                                        </div>
                                    </div>`;
                                $("#announcementCardBody").append(card);
                            });
                        } else {
                            $("#announcementCardBody").html(`<div class="col-12"><p class="text-center">داده‌ای برای نمایش موجود نیست</p></div>`);
                        }
                    })
                    .catch(error => {
                        console.error("خطا در دریافت داده‌ها:", error);
                        $("#errorModal").modal('show');
                    })
                    .finally(() => {
                        $("#loadingSpinner").addClass("d-none");
                        $("#filterBtn").prop("disabled", false).find(".spinner-border").addClass("d-none");
                    });
            }

            loadAnnouncements();
        });
    </script>
</body>
</html>
